# Copy to deploy.env in this folder. Do not commit deploy.env.
# Use a Cloudflare API token from the Edit Cloudflare Workers template.
# TURNSTILE_HOSTNAMES is the public site hostname. Do not include localhost.
CLOUDFLARE_API_TOKEN=
TURNSTILE_SECRET=
LINEAR_API_KEY=
TURNSTILE_HOSTNAMES=
# Optional: a Discord channel webhook. New mod versions are posted there after each deploy.
DISCORD_WEBHOOK_URL=
# Optional: the POI owners page (poi.azraelsmods.com). POI_INGEST_TOKEN is the token the game
# server's POI Registry mod sends; POI_VIEW_TOKEN is the page password (leave empty for a public page).
POI_INGEST_TOKEN=
POI_VIEW_TOKEN=
