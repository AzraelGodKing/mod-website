---
import { statRows } from "../data/stats";
import { statText, statValues } from "../data/stat-values.mjs";
import { statsSnapshot } from "../data/stats-snapshot";

interface Props {
  game: string;
  mod?: string;
  variant: "room" | "hero";
}

const { game, mod, variant } = Astro.props;
const rows = statRows(game, variant === "hero");
const values = mod ? statValues(statsSnapshot, "mod", `${game}/${mod}`) : statValues(statsSnapshot, "game", game);
---

<dl
  class:list={["counts", `counts-${variant}`]}
  data-stat-scope={mod ? "mod" : "game"}
  data-stat-key={mod ? `${game}/${mod}` : game}
>
  {
    rows.map((row) => (
      <div>
        <dt>{row.label}</dt>
        <dd data-field={row.field}>{statText(values, row.field)}</dd>
      </div>
    ))
  }
</dl>
