---
import { statRows } from "../data/stats";

interface Props {
  game: string;
  mod?: string;
  variant: "room" | "hero";
}

const { game, mod, variant } = Astro.props;
const rows = statRows(game, variant === "hero");
---

<dl
  class:list={["counts", `counts-${variant}`]}
  data-stat-scope={mod ? "mod" : "game"}
  data-stat-key={mod ? `${game}/${mod}` : game}
>
  {
    rows.map((row) => (
      <div>
        <dt>{row.label}</dt>
        <dd data-field={row.field}>—</dd>
      </div>
    ))
  }
</dl>
