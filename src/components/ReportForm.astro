---
import { turnstileSitekey } from "../data/turnstile-sitekey";

interface Props {
  game: string;
  mod: string;
  name: string;
  gameName: string;
}

const { game, mod, name, gameName } = Astro.props;
---

<section class="report" id="report">
  <h2>Report a problem</h2>
  <div class="known-issues" id="known-issues" hidden>
    <h3>Known issues</h3>
    <p class="known-note">Already on the list. No need to report these again.</p>
    <ul></ul>
  </div>
  <p>This report is for {name} on {gameName}.</p>
  <button type="button" class="report-open" aria-controls="report-form" aria-expanded="false">Write a report</button>
  <form id="report-form" hidden data-sitekey={turnstileSitekey} data-game={game} data-mod={mod}>
    <label>
      Summary
      <input name="summary" required minlength="8" maxlength="120" autocomplete="off" />
    </label>
    <label>
      What happened
      <textarea name="details" required minlength="20" maxlength="4000" rows="6"></textarea>
    </label>
    <div id="report-turnstile"></div>
    <p id="report-status" role="status"></p>
    <button type="submit">Send report</button>
  </form>
</section>

<script is:inline>
  // Open issues for this mod, from Linear through the Worker. Hidden when there are none.
  (async () => {
    const box = document.querySelector("#known-issues");
    const source = document.querySelector("#report-form");
    if (!box || !source) return;
    try {
      const response = await fetch(`/api/issues?mod=${encodeURIComponent(`${source.dataset.game}/${source.dataset.mod}`)}`);
      if (!response.ok) return;
      const { issues } = await response.json();
      if (!Array.isArray(issues) || issues.length === 0) return;
      const list = box.querySelector("ul");
      for (const issue of issues) {
        const item = document.createElement("li");
        const title = document.createElement("span");
        title.textContent = issue.title;
        const status = document.createElement("span");
        status.className = issue.started ? "known-status known-started" : "known-status";
        status.textContent = issue.status;
        item.append(title, status);
        list.append(item);
      }
      box.hidden = false;
    } catch {
      // The form still works without the list.
    }
  })();
  const form = document.querySelector("#report-form");
  const status = document.querySelector("#report-status");
  window.onAzraelTurnstile = () => {
    form.dataset.widgetId = String(
      turnstile.render("#report-turnstile", {
        sitekey: form.dataset.sitekey,
        action: "report",
      }),
    );
  };
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = form.querySelector("button");
    const token = window.turnstile?.getResponse(form.dataset.widgetId);
    if (!token) {
      status.textContent = "Finish the check, then submit.";
      return;
    }
    const parts = location.pathname.split("/").filter(Boolean);
    if (parts[0] !== form.dataset.game || parts[1] !== form.dataset.mod) {
      status.textContent = "This report does not match this page.";
      return;
    }
    button.disabled = true;
    status.textContent = "Sending…";
    try {
      const response = await fetch("/api/report", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          game: parts[0],
          mod: parts[1],
          summary: new FormData(form).get("summary"),
          details: new FormData(form).get("details"),
          turnstileToken: token,
        }),
      });
      const payload = await response.json();
      if (response.ok && payload.ok === true) {
        const issue =
          typeof payload.issue === "string" && /^[A-Z][A-Z0-9]+-\d+$/.test(payload.issue)
            ? ` Report ${payload.issue}.`
            : "";
        const done = document.createElement("p");
        done.textContent = `Report sent.${issue}`;
        form.replaceWith(done);
        return;
      }
      status.textContent =
        typeof payload.error === "string" ? payload.error : "The report could not be filed. Try again.";
      window.turnstile?.reset(form.dataset.widgetId);
    } catch {
      status.textContent = "The report could not be filed. Try again.";
      window.turnstile?.reset(form.dataset.widgetId);
    } finally {
      if (form.isConnected) button.disabled = false;
    }
  });
  // The form stays folded until someone asks for it, and Turnstile loads only then,
  // so reading a mod page does not pull in the challenge script.
  let requested = false;
  const loadTurnstile = () => {
    if (requested) return;
    requested = true;
    const script = document.createElement("script");
    script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onAzraelTurnstile";
    script.async = true;
    document.head.append(script);
  };
  const opener = document.querySelector(".report-open");
  const openForm = (focus) => {
    form.hidden = false;
    opener.hidden = true;
    opener.setAttribute("aria-expanded", "true");
    loadTurnstile();
    if (focus) form.querySelector("input")?.focus();
  };
  opener.addEventListener("click", () => openForm(true));
  if (location.hash === "#report") openForm(false);
</script>
