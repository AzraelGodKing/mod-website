---
import "../styles/site.css";
import { games } from "../data/games";
import { gameVars } from "../data/themes";

interface Props {
  title: string;
  description: string;
  game?: string;
}

const { title, description, game } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body style={gameVars(game)}>
    <header>
      <a href="/">Azrael's Mods</a>
      <nav aria-label="Games">
        {
          games.map((entry) => (
            <a
              href={`/${entry.slug}`}
              aria-current={
                entry.slug === game ? (here === `/${entry.slug}` ? "page" : "true") : undefined
              }
            >
              {entry.name}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
