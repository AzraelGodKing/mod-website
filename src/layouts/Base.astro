---
import "../styles/fonts.css";
import "../styles/site.css";
import cormorant600 from "../assets/fonts/cormorant-garamond-latin-600-normal.woff2?url";
import fraunces from "../assets/fonts/fraunces-latin-opsz-normal.woff2?url";
import outfit from "../assets/fonts/outfit-latin-wght-normal.woff2?url";
import redHat from "../assets/fonts/red-hat-text-latin-wght-normal.woff2?url";
import { games } from "../data/games";
import { gameVars, themeColor } from "../data/themes";
import { KOFI_URL, SUBDOMAINS } from "../data/links.mjs";

interface Props {
  title: string;
  description: string;
  game?: string;
  home?: boolean;
  admin?: boolean;
  // Pages that should stay out of search results, such as /not-ready.
  noindex?: boolean;
  // The picture link previews show (Discord, Reddit, Nexus). A square store
  // icon gets the small card; a wide poster gets the large one.
  image?: { src: string; alt: string; square?: boolean };
  // A mod page's own release feed.
  feed?: { title: string; href: string };
}

const {
  title,
  description,
  game,
  home = false,
  admin = false,
  noindex = false,
  feed,
  // Pages without their own picture share the site card from scripts/make-share-image.mjs.
  image = { src: "/share.jpg", alt: "Azrael's Mods: mods for RimWorld, Sun Haven, and 7 Days to Die" },
} = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const siteName = "Azrael's Mods";
const fullTitle = title === siteName || title.endsWith(` · ${siteName}`) ? title : `${title} · ${siteName}`;
const canonical = new URL(here === "/" ? "/" : here, Astro.site);
const imageUrl = image ? new URL(image.src, Astro.site).href : undefined;
const gameName = games.find((entry) => entry.slug === game)?.name;
// Preload only the fonts the first screen of this page draws with, so text
// shows in its own face without waiting on the stylesheet.
const preloads =
  game === "sun-haven" ? [fraunces, outfit] : game === "7-days-to-die" ? [] : [cormorant600, redHat];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor(home || admin ? undefined : game)} />
    {(admin || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <title>{fullTitle}</title>
    {!(admin || noindex) && <link rel="canonical" href={canonical.href} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {image?.src === "/share.jpg" && <meta property="og:image:width" content="1200" />}
    {image?.src === "/share.jpg" && <meta property="og:image:height" content="630" />}
    {imageUrl && <meta property="og:image:alt" content={image?.alt} />}
    <meta name="twitter:card" content={imageUrl && !image?.square ? "summary_large_image" : "summary"} />
    {!admin && <link rel="alternate" type="application/rss+xml" title="Azrael's Mods: new releases" href="/feed.xml" />}
    {!admin && gameName && <link rel="alternate" type="application/rss+xml" title={`Azrael's Mods: ${gameName} releases`} href={`/${game}/feed.xml`} />}
    {!admin && feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />}
    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <slot name="head" />
  </head>
  <body
    class:list={[game === "rimworld" && "rw-site", (home || admin) && "entry-site", admin && "admin-site"]}
    style={gameVars(game)}
  >
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <a href="/">Azrael's Mods</a>
      <nav aria-label="Games">
        {
          games.map((entry) => (
            <a
              href={`/${entry.slug}`}
              aria-current={
                entry.slug === game ? (here === `/${entry.slug}` ? "page" : "true") : undefined
              }
            >
              {entry.name}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {
      !admin && (
        <footer class="site-footer">
          <nav aria-label="Source code">
            <span>Source on GitHub:</span>
            {games.map((entry) => (
              <a href={entry.repo}>{entry.name}</a>
            ))}
          </nav>
          <nav aria-label="More from Azrael">
            <span>More:</span>
            {Object.values(SUBDOMAINS).map((entry) => (
              <a href={entry.href}>{entry.label}</a>
            ))}
          </nav>
          <p>Found a bug? Use “Report a problem” on any mod page.</p>
          <p class="footer-kofi">
            Enjoying the mods? <a href={KOFI_URL} rel="me">Support me on Ko-fi</a>
          </p>
        </footer>
      )
    }
    <script>
      import { statText, statValues } from "../data/stat-values.mjs";

      // The build already wrote the counts it had; this swaps in the live numbers.
      const lists = document.querySelectorAll<HTMLElement>("[data-stat-key]");
      if (lists.length > 0) {
        fetch("/api/stats")
          .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
          .then((snapshot) => {
            document.dispatchEvent(new CustomEvent("stats:loaded", { detail: snapshot }));
            for (const list of lists) {
              const values = statValues(snapshot, list.dataset.statScope === "game" ? "game" : "mod", list.dataset.statKey ?? "");
              if (!values) continue;
              for (const cell of list.querySelectorAll<HTMLElement>("[data-field]")) {
                cell.textContent = statText(values, cell.dataset.field ?? "");
              }
            }
          })
          .catch(() => {});
      }
    </script>
    <script is:inline>
      // The build's versions are already on the page. A mod released since then
      // shows its newer version and zip name from the Worker.
      (() => {
        const cells = document.querySelectorAll("[data-latest]");
        if (cells.length === 0) return;
        const day = new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeZone: "UTC" });
        fetch("/api/downloads")
          .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
          .then((latest) => {
            document.dispatchEvent(new CustomEvent("downloads:loaded", { detail: latest }));
            for (const cell of cells) {
              const entry = latest[cell.dataset.latest];
              const value = entry?.[cell.dataset.latestField];
              // A newer zip with no recorded checksum or size: the build's would be wrong.
              if (!value && entry) cell.closest("[data-fact]")?.setAttribute("hidden", "");
              if (!value) continue;
              if (cell.dataset.latestField === "uploadedAt") {
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) continue;
                cell.setAttribute("datetime", date.toISOString());
                cell.textContent = day.format(date);
              } else if (cell.dataset.latestField === "sha256") {
                cell.dataset.value = value;
                cell.title = value;
                cell.textContent = `${value.slice(0, 16)}…`;
              } else {
                cell.textContent = value;
              }
              // A size or checksum the build did not have yet.
              cell.closest("[data-fact]")?.removeAttribute("hidden");
            }
          })
          .catch(() => {});
      })();
    </script>
  </body>
</html>
