---
import "../styles/site.css";
import { games } from "../data/games";
import { gameVars, themeColor } from "../data/themes";

interface Props {
  title: string;
  description: string;
  game?: string;
  home?: boolean;
  admin?: boolean;
  // Pages that should stay out of search results, such as /not-ready.
  noindex?: boolean;
  // The picture link previews show (Discord, Reddit, Nexus). A square store
  // icon gets the small card; a wide poster gets the large one.
  image?: { src: string; alt: string; square?: boolean };
}

const { title, description, game, home = false, admin = false, noindex = false, image } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const siteName = "Azrael's Mods";
const fullTitle = title === siteName || title.endsWith(` · ${siteName}`) ? title : `${title} · ${siteName}`;
const canonical = new URL(here === "/" ? "/" : here, Astro.site);
const imageUrl = image ? new URL(image.src, Astro.site).href : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor(home || admin ? undefined : game)} />
    {(admin || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <title>{fullTitle}</title>
    {!(admin || noindex) && <link rel="canonical" href={canonical.href} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={image?.alt} />}
    <meta name="twitter:card" content={imageUrl && !image?.square ? "summary_large_image" : "summary"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,560&family=Outfit:wght@400;600;700&family=Red+Hat+Text:wght@400;600;700&display=swap"
    />
  </head>
  <body
    class:list={[game === "rimworld" && "rw-site", (home || admin) && "entry-site", admin && "admin-site"]}
    style={gameVars(game)}
  >
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <a href="/">Azrael's Mods</a>
      <nav aria-label="Games">
        {
          games.map((entry) => (
            <a
              href={`/${entry.slug}`}
              aria-current={
                entry.slug === game ? (here === `/${entry.slug}` ? "page" : "true") : undefined
              }
            >
              {entry.name}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {
      !admin && (
        <footer class="site-footer">
          <nav aria-label="Source code">
            <span>Source on GitHub:</span>
            {games.map((entry) => (
              <a href={entry.repo}>{entry.name}</a>
            ))}
          </nav>
          <p>Found a bug? Use “Report a problem” at the bottom of any mod page.</p>
        </footer>
      )
    }
    <script is:inline>
      (() => {
        const lists = document.querySelectorAll("[data-stat-key]");
        if (lists.length === 0) return;
        const format = (value) => (typeof value === "number" ? value.toLocaleString("en-US") : "—");
        const counts = (snapshot, list) => {
          const key = list.dataset.statKey;
          if (list.dataset.statScope === "game") return snapshot.games?.[key] ?? null;
          const mod = snapshot.mods?.[key];
          if (!mod) return null;
          const thunderstore = mod.thunderstore?.downloads ?? null;
          const nexus = mod.nexus?.downloads ?? null;
          const site = mod.site?.downloads ?? null;
          const parts = [site, thunderstore, nexus].filter((value) => value !== null);
          return {
            site,
            total: parts.length > 0 ? parts.reduce((sum, value) => sum + value, 0) : null,
            steam: mod.steam?.subscriptions ?? null,
            thunderstore,
            nexus,
            nexus_unique: mod.nexus?.unique ?? null,
            combined: thunderstore === null && nexus === null ? null : (thunderstore ?? 0) + (nexus ?? 0),
          };
        };
        fetch("/api/stats")
          .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
          .then((snapshot) => {
            document.dispatchEvent(new CustomEvent("stats:loaded", { detail: snapshot }));
            for (const list of lists) {
              const values = counts(snapshot, list);
              if (!values) continue;
              for (const cell of list.querySelectorAll("[data-field]")) {
                const field = cell.dataset.field;
                if (field === "nexus_full") {
                  cell.textContent =
                    typeof values.nexus === "number"
                      ? `${format(values.nexus)} (${format(values.nexus_unique)} unique)`
                      : "—";
                } else {
                  cell.textContent = format(values[field]);
                }
              }
            }
          })
          .catch(() => {});
      })();
    </script>
    <script is:inline>
      // The build's versions are already on the page. A mod released since then
      // shows its newer version and zip name from the Worker.
      (() => {
        const cells = document.querySelectorAll("[data-latest]");
        if (cells.length === 0) return;
        const day = new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeZone: "UTC" });
        fetch("/api/downloads")
          .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
          .then((latest) => {
            document.dispatchEvent(new CustomEvent("downloads:loaded", { detail: latest }));
            for (const cell of cells) {
              const entry = latest[cell.dataset.latest];
              const value = entry?.[cell.dataset.latestField];
              if (!value) continue;
              if (cell.dataset.latestField === "uploadedAt") {
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) continue;
                cell.setAttribute("datetime", date.toISOString());
                cell.textContent = day.format(date);
              } else {
                cell.textContent = value;
              }
            }
          })
          .catch(() => {});
      })();
    </script>
  </body>
</html>
