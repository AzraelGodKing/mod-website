---
import "../styles/site.css";
import { games } from "../data/games";
import { gameVars } from "../data/themes";

interface Props {
  title: string;
  description: string;
  game?: string;
  home?: boolean;
  admin?: boolean;
}

const { title, description, game, home = false, admin = false } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {admin && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body
    class:list={[game === "rimworld" && "rw-site", (home || admin) && "entry-site", admin && "admin-site"]}
    style={gameVars(game)}
  >
    <header>
      <a href="/">Azrael's Mods</a>
      <nav aria-label="Games">
        {
          games.map((entry) => (
            <a
              href={`/${entry.slug}`}
              aria-current={
                entry.slug === game ? (here === `/${entry.slug}` ? "page" : "true") : undefined
              }
            >
              {entry.name}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script is:inline>
      (() => {
        const lists = document.querySelectorAll("[data-stat-key]");
        if (lists.length === 0) return;
        const format = (value) => (typeof value === "number" ? value.toLocaleString("en-US") : "—");
        const counts = (snapshot, list) => {
          const key = list.dataset.statKey;
          if (list.dataset.statScope === "game") return snapshot.games?.[key] ?? null;
          const mod = snapshot.mods?.[key];
          if (!mod) return null;
          const thunderstore = mod.thunderstore?.downloads ?? null;
          const nexus = mod.nexus?.downloads ?? null;
          return {
            steam: mod.steam?.subscriptions ?? null,
            thunderstore,
            nexus,
            nexus_unique: mod.nexus?.unique ?? null,
            combined: thunderstore === null && nexus === null ? null : (thunderstore ?? 0) + (nexus ?? 0),
          };
        };
        fetch("/api/stats")
          .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
          .then((snapshot) => {
            document.dispatchEvent(new CustomEvent("stats:loaded", { detail: snapshot }));
            for (const list of lists) {
              const values = counts(snapshot, list);
              if (!values) continue;
              for (const cell of list.querySelectorAll("[data-field]")) {
                const field = cell.dataset.field;
                if (field === "nexus_full") {
                  cell.textContent =
                    typeof values.nexus === "number"
                      ? `${format(values.nexus)} (${format(values.nexus_unique)} unique)`
                      : "—";
                } else {
                  cell.textContent = format(values[field]);
                }
              }
            }
          })
          .catch(() => {});
      })();
    </script>
    <script is:inline>
      // The build's versions are already on the page. A mod released since then
      // shows its newer version and zip name from the Worker.
      (() => {
        const cells = document.querySelectorAll("[data-latest]");
        if (cells.length === 0) return;
        const day = new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeZone: "UTC" });
        fetch("/api/downloads")
          .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
          .then((latest) => {
            document.dispatchEvent(new CustomEvent("downloads:loaded", { detail: latest }));
            for (const cell of cells) {
              const entry = latest[cell.dataset.latest];
              const value = entry?.[cell.dataset.latestField];
              if (!value) continue;
              if (cell.dataset.latestField === "uploadedAt") {
                const date = new Date(value);
                if (Number.isNaN(date.getTime())) continue;
                cell.setAttribute("datetime", date.toISOString());
                cell.textContent = day.format(date);
              } else {
                cell.textContent = value;
              }
            }
          })
          .catch(() => {});
      })();
    </script>
  </body>
</html>
