---
import Base from "../layouts/Base.astro";
import StoreCounts from "../components/StoreCounts.astro";
import { games } from "../data/games";
import { modsForGame, r2Download, uploadedOn } from "../data/mods";
import { indexInfo, installLabels, sevendaysCategories } from "../data/sevendays-index";
import { heroVars, lookFor } from "../data/themes";

export function getStaticPaths() {
  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const gameMods = modsForGame(game.slug);
const rimworld = game.slug === "rimworld";
const sunhaven = game.slug === "sun-haven";
const sevendays = game.slug === "7-days-to-die";
const featured = [
  "homesteader",
  "stormproof",
  "strata",
  "nemesis",
  "deep-colony",
  "date-night",
  "niceties",
  "azrael",
  "living-world",
];
const rimworldMods = [...gameMods].sort((a, b) => {
  const left = featured.indexOf(a.slug);
  const right = featured.indexOf(b.slug);
  return (left < 0 ? featured.length : left) - (right < 0 ? featured.length : right);
});
const sunOrder = [
  "the-vault",
  "havens-birthright",
  "faster-races",
  "havens-mirror",
  "trinket-fortune",
  "smut",
  "sunhaven-todo",
  "birthday-reminder",
  "gifting-assistant",
  "senpais-chest",
  "havens-almanac",
  "crop-optimizer",
  "havens-respec",
  "haven-dev-tools",
];
const sunGroup: Record<string, string> = {
  "the-vault": "Storage",
  "senpais-chest": "Storage",
  "havens-birthright": "Skills",
  "faster-races": "Skills",
  "havens-respec": "Skills",
  "havens-mirror": "UI",
  "havens-almanac": "UI",
  "trinket-fortune": "Tracking",
  smut: "Tracking",
  "crop-optimizer": "Tracking",
  "sunhaven-todo": "QoL",
  "birthday-reminder": "Social",
  "gifting-assistant": "Social",
  "haven-dev-tools": "Dev",
};
const sevenRows = [...gameMods]
  .sort((a, b) => a.name.localeCompare(b.name))
  .map((mod) => ({ mod, info: indexInfo(mod), direct: r2Download(mod), updated: uploadedOn(mod) }));
const sunFilters = ["All", "QoL", "Storage", "UI", "Social", "Tracking", "Skills", "Dev"];
const sunMods = [...gameMods].sort((a, b) => {
  const left = sunOrder.indexOf(a.slug);
  const right = sunOrder.indexOf(b.slug);
  return (left < 0 ? sunOrder.length : left) - (right < 0 ? sunOrder.length : right);
});
---

<Base title={`${game.name} mods`} description={`Mods for ${game.name}.`} game={game.slug}>
  {
    rimworld ? (
      <div class="rw-hub">
        <header class="rw-hero">
          <div class="rw-wrap rw-hero-layout">
            <div>
              <p class="rw-kicker">RimWorld</p>
              <h1>RimWorld Mods</h1>
              <p class="rw-tagline">
                RimWorld mods for colonies that farm, harden, dig, remember, make time for each other, and keep the small comforts.
              </p>
              <p class="rw-intro">
                {rimworldMods.length} mods. Open a card for the mod page, the download, and the workshop links.
              </p>
            </div>
            <aside class="rw-stats">
              <span class="rw-stat-label">Mods</span>
              <span class="rw-stat-num">{rimworldMods.length}</span>
              <StoreCounts game={game.slug} variant="hero" />
            </aside>
          </div>
        </header>
        <div class="rw-wrap">
          <div class="rw-controls">
            <input id="rw-search" type="search" placeholder="Search mods…" aria-label="Search mods" autocomplete="off" />
            <select id="rw-sort" aria-label="Sort">
              <option value="featured">Featured order</option>
              <option value="name">Name A–Z</option>
            </select>
          </div>
          <div class="rw-grid" id="rw-grid">
            {rimworldMods.map((mod, index) => {
              const look = lookFor(mod.slug);
              const preview = mod.slug === "azrael" ? undefined : mod.images[0];
              return (
                <a
                  class:list={["rw-card", index === 0 && "rw-lead"]}
                  style={heroVars(mod.slug)}
                  href={`/${game.slug}/${mod.slug}`}
                  data-name={mod.name.toLowerCase()}
                  data-text={`${mod.name} ${mod.description}`.toLowerCase()}
                  data-order={index}
                >
                  <span class="rw-media">
                    {preview ? <img src={preview} alt="" /> : <span class="rw-plate">{look.mark}</span>}
                  </span>
                  <span class="rw-copy">
                    <h2>{mod.name}</h2>
                    <p>{mod.description}</p>
                    <StoreCounts game={game.slug} mod={mod.slug} variant="card" />
                    <span class="rw-badges">
                      <span>Version <span data-latest={`${mod.game}/${mod.slug}`} data-latest-field="version">{mod.version}</span></span>
                      <span>{look.mark}</span>
                    </span>
                  </span>
                </a>
              );
            })}
          </div>
          <p class="rw-empty" id="rw-empty" hidden>
            No mods match that search.
          </p>
        </div>
        <script is:inline>
          const grid = document.querySelector("#rw-grid");
          const search = document.querySelector("#rw-search");
          const sort = document.querySelector("#rw-sort");
          const empty = document.querySelector("#rw-empty");
          const cards = [...grid.querySelectorAll(".rw-card")];
          function apply() {
            const query = search.value.trim().toLowerCase();
            const byName = sort.value === "name";
            const ordered = [...cards].sort((a, b) => {
              if (byName) return a.dataset.name.localeCompare(b.dataset.name);
              return Number(a.dataset.order) - Number(b.dataset.order);
            });
            let lead = null;
            for (const card of ordered) {
              card.hidden = Boolean(query) && !card.dataset.text.includes(query);
              card.classList.remove("rw-lead");
              grid.appendChild(card);
              if (!card.hidden && !lead) lead = card;
            }
            if (lead) lead.classList.add("rw-lead");
            empty.hidden = Boolean(lead);
          }
          search.addEventListener("input", apply);
          sort.addEventListener("change", apply);
        </script>
      </div>
    ) : sunhaven ? (
      <div class="sh-hub">
        <header class="sh-hero">
          <p class="sh-kicker">BepInEx plugins for Sun Haven</p>
          <h1>
            Make every day in Haven <em>a little brighter.</em>
          </h1>
          <p>
            {sunMods.length} quality-of-life mods that track your museum, sort your chests, bank your tokens, remember every birthday, and plan your farm — each one standalone, all of them better together.
          </p>
          <StoreCounts game={game.slug} variant="hero" />
        </header>
        <div class="sh-wrap">
          <div class="sh-controls">
            <input id="sh-search" type="search" placeholder="Search by name or description…" aria-label="Search mods" autocomplete="off" />
            <div class="sh-filters" role="group" aria-label="Filter mods">
              {sunFilters.map((filter) => (
                <button type="button" class:list={["sh-filter", filter === "All" && "is-on"]} data-group={filter.toLowerCase()}>
                  {filter}
                </button>
              ))}
            </div>
            <p class="sh-count" id="sh-count">
              Showing all {sunMods.length} mods.
            </p>
          </div>
          <div class="sh-grid" id="sh-grid">
            {sunMods.map((mod) => {
              const look = lookFor(mod.slug);
              const group = sunGroup[mod.slug] ?? "QoL";
              return (
                <a
                  class="sh-card"
                  href={`/${game.slug}/${mod.slug}`}
                  data-group={group.toLowerCase()}
                  data-text={`${mod.name} ${look.mark} ${mod.description}`.toLowerCase()}
                >
                  <span class="sh-top">
                    <span>
                      <h2>{mod.name}</h2>
                      <span class="sh-sub">{look.mark}</span>
                    </span>
                    <span class="sh-ver">v<span data-latest={`${mod.game}/${mod.slug}`} data-latest-field="version">{mod.version}</span></span>
                  </span>
                  <p>{mod.description}</p>
                  <StoreCounts game={game.slug} mod={mod.slug} variant="card" />
                  <span class="sh-open">Open mod page →</span>
                </a>
              );
            })}
          </div>
          <p class="sh-empty" id="sh-empty" hidden>
            No mods match that search.
          </p>
        </div>
        <script is:inline>
          const grid = document.querySelector("#sh-grid");
          const search = document.querySelector("#sh-search");
          const count = document.querySelector("#sh-count");
          const empty = document.querySelector("#sh-empty");
          const cards = [...grid.querySelectorAll(".sh-card")];
          const filters = [...document.querySelectorAll(".sh-filter")];
          let group = "all";
          function apply() {
            const query = search.value.trim().toLowerCase();
            let shown = 0;
            for (const card of cards) {
              const groupOk = group === "all" || card.dataset.group === group;
              const textOk = !query || card.dataset.text.includes(query);
              card.hidden = !(groupOk && textOk);
              if (!card.hidden) shown += 1;
            }
            count.textContent = shown === cards.length ? `Showing all ${cards.length} mods.` : `Showing ${shown} mods.`;
            empty.hidden = shown > 0;
          }
          for (const filter of filters) {
            filter.addEventListener("click", () => {
              group = filter.dataset.group;
              for (const button of filters) button.classList.toggle("is-on", button === filter);
              apply();
            });
          }
          search.addEventListener("input", apply);
        </script>
      </div>
    ) : sevendays ? (
      <div class="zd-hub">
        <header class="zd-hero">
          <p class="zd-kicker">7 Days to Die</p>
          <h1>After dark.</h1>
          <p>
            {gameMods.length} mods for the horde. Search, filter by what you need, and see at a glance whether it goes on the server, your game, or both.
          </p>
          <StoreCounts game={game.slug} variant="hero" />
        </header>
        <div class="zd-hazard" aria-hidden="true"></div>
        <div class="zd-wrap">
          <div class="zd-toolbar">
            <label class="zd-search">
              <span class="sr-only">Search mods</span>
              <input id="zd-search" type="search" placeholder="Search mods…  ( / )" autocomplete="off" />
            </label>
            <label class="zd-sort">
              <span>Sort</span>
              <select id="zd-sort">
                <option value="name">Name A–Z</option>
                <option value="updated">Recently updated</option>
                <option value="downloads">Most downloaded</option>
                <option value="category">Category</option>
              </select>
            </label>
          </div>
          <div class="zd-filters">
            <div class="zd-chips" role="group" aria-label="Category" data-filter="cat">
              <span class="zd-chips-label">Type</span>
              {["All", ...sevendaysCategories].map((name) => (
                <button type="button" class:list={["zd-chip", name === "All" && "is-on"]} data-value={name === "All" ? "" : name} aria-pressed={name === "All" ? "true" : "false"}>
                  {name}
                </button>
              ))}
            </div>
            <div class="zd-chips" role="group" aria-label="Installs on" data-filter="side">
              <span class="zd-chips-label">Installs on</span>
              {[["", "Anywhere"], ["server", "Server only"], ["client", "Client only"], ["both", "Server + clients"]].map(([value, name]) => (
                <button type="button" class:list={["zd-chip", value === "" && "is-on"]} data-value={value} aria-pressed={value === "" ? "true" : "false"}>
                  {name}
                </button>
              ))}
            </div>
          </div>
          <p class="zd-count" id="zd-count" aria-live="polite">
            Showing all {sevenRows.length} mods
          </p>
          <div class="zd-list" role="table" aria-label="7 Days to Die mods">
            <div class="zd-head" role="row">
              <button type="button" role="columnheader" data-sort="name">Mod</button>
              <button type="button" role="columnheader" data-sort="category">Type</button>
              <span role="columnheader">Installs on</span>
              <span role="columnheader">Version</span>
              <button type="button" role="columnheader" data-sort="updated">Updated</button>
              <button type="button" role="columnheader" data-sort="downloads">Downloads</button>
              <span role="columnheader"><span class="sr-only">Download</span></span>
            </div>
            <div id="zd-rows">
              {sevenRows.map(({ mod, info, direct, updated }) => (
                <div
                  class="zd-row"
                  role="row"
                  style={heroVars(mod.slug)}
                  data-key={`${mod.game}/${mod.slug}`}
                  data-name={mod.name.toLowerCase()}
                  data-cat={info.category}
                  data-side={info.installs}
                  data-updated={updated?.iso ?? ""}
                  data-downloads="-1"
                  data-text={`${mod.name} ${info.short} ${info.category} ${installLabels[info.installs]} ${mod.description}`.toLowerCase()}
                >
                  <a class="zd-name" role="cell" href={`/${game.slug}/${mod.slug}`}>
                    <strong>{mod.name}</strong>
                    <span>{info.short}</span>
                  </a>
                  <span class="zd-cat" role="cell">{info.category}</span>
                  <span class:list={["zd-side", `is-${info.installs}`]} role="cell">{installLabels[info.installs]}</span>
                  <span class="zd-ver" role="cell">
                    v<span data-latest={`${mod.game}/${mod.slug}`} data-latest-field="version">{mod.version}</span>
                  </span>
                  <span class="zd-date" role="cell">
                    <span class="zd-cell-label">Updated </span>
                    {updated ? (
                      <time datetime={updated.iso} data-latest={`${mod.game}/${mod.slug}`} data-latest-field="uploadedAt">{updated.label}</time>
                    ) : (
                      <time data-latest={`${mod.game}/${mod.slug}`} data-latest-field="uploadedAt">—</time>
                    )}
                  </span>
                  <span class="zd-dl" role="cell">
                    <span class="zd-cell-label">Downloads </span>
                    <span data-dl-count>—</span>
                  </span>
                  <span class="zd-act" role="cell">
                    {direct ? (
                      <a class="zd-get" href={direct.url} aria-label={`Download ${mod.name}`}>Download</a>
                    ) : (
                      <a class="zd-get is-soon" href="/not-ready">Soon</a>
                    )}
                  </span>
                </div>
              ))}
            </div>
          </div>
          <p class="zd-empty" id="zd-empty" hidden>
            No mods match. <button type="button" id="zd-reset">Clear search and filters</button>
          </p>
        </div>
        <script is:inline>
          (() => {
            const rowsBox = document.querySelector("#zd-rows");
            const rows = [...rowsBox.querySelectorAll(".zd-row")];
            const search = document.querySelector("#zd-search");
            const sort = document.querySelector("#zd-sort");
            const count = document.querySelector("#zd-count");
            const empty = document.querySelector("#zd-empty");
            const heads = [...document.querySelectorAll(".zd-head [data-sort]")];
            const groups = [...document.querySelectorAll(".zd-chips[data-filter]")];
            const sorts = ["name", "updated", "downloads", "category"];
            const state = { q: "", cat: "", side: "", sort: "name" };

            const params = new URLSearchParams(location.search);
            state.q = params.get("q") ?? "";
            state.cat = params.get("type") ?? "";
            state.side = params.get("installs") ?? "";
            if (sorts.includes(params.get("sort"))) state.sort = params.get("sort");

            const byName = (a, b) => a.dataset.name.localeCompare(b.dataset.name);
            const compare = {
              name: byName,
              category: (a, b) => a.dataset.cat.localeCompare(b.dataset.cat) || byName(a, b),
              // Rows with no date or count yet sink to the bottom instead of jumping around.
              updated: (a, b) => (b.dataset.updated || "").localeCompare(a.dataset.updated || "") || byName(a, b),
              downloads: (a, b) => Number(b.dataset.downloads) - Number(a.dataset.downloads) || byName(a, b),
            };

            function save() {
              const next = new URLSearchParams();
              if (state.q) next.set("q", state.q);
              if (state.cat) next.set("type", state.cat);
              if (state.side) next.set("installs", state.side);
              if (state.sort !== "name") next.set("sort", state.sort);
              const query = next.toString();
              history.replaceState(null, "", query ? `?${query}` : location.pathname);
            }

            function apply() {
              const words = state.q.trim().toLowerCase().split(/\s+/).filter(Boolean);
              let shown = 0;
              for (const row of [...rows].sort(compare[state.sort])) {
                const ok =
                  (!state.cat || row.dataset.cat === state.cat) &&
                  (!state.side || row.dataset.side === state.side) &&
                  words.every((word) => row.dataset.text.includes(word));
                row.hidden = !ok;
                if (ok) shown += 1;
                rowsBox.appendChild(row);
              }
              count.textContent = shown === rows.length ? `Showing all ${rows.length} mods` : `Showing ${shown} of ${rows.length} mods`;
              empty.hidden = shown > 0;
              sort.value = state.sort;
              for (const head of heads) head.setAttribute("aria-sort", head.dataset.sort === state.sort ? (state.sort === "name" || state.sort === "category" ? "ascending" : "descending") : "none");
              for (const group of groups) {
                const value = state[group.dataset.filter];
                for (const chip of group.querySelectorAll(".zd-chip")) {
                  const on = chip.dataset.value === value;
                  chip.classList.toggle("is-on", on);
                  chip.setAttribute("aria-pressed", String(on));
                }
              }
              save();
            }

            search.value = state.q;
            search.addEventListener("input", () => { state.q = search.value; apply(); });
            sort.addEventListener("change", () => { state.sort = sort.value; apply(); });
            for (const head of heads) head.addEventListener("click", () => { state.sort = head.dataset.sort; apply(); });
            for (const group of groups) {
              group.addEventListener("click", (event) => {
                const chip = event.target.closest(".zd-chip");
                if (!chip) return;
                state[group.dataset.filter] = chip.dataset.value;
                apply();
              });
            }
            document.querySelector("#zd-reset").addEventListener("click", () => {
              Object.assign(state, { q: "", cat: "", side: "" });
              search.value = "";
              apply();
              search.focus();
            });
            document.addEventListener("keydown", (event) => {
              if (event.key !== "/" || event.target.closest("input, select, textarea")) return;
              event.preventDefault();
              search.focus();
            });

            document.addEventListener("stats:loaded", (event) => {
              const mods = event.detail?.mods ?? {};
              const format = new Intl.NumberFormat("en-US");
              for (const row of rows) {
                const value = mods[row.dataset.key]?.nexus?.downloads;
                if (typeof value !== "number") continue;
                row.dataset.downloads = String(value);
                row.querySelector("[data-dl-count]").textContent = format.format(value);
              }
              apply();
            });
            document.addEventListener("downloads:loaded", (event) => {
              const latest = event.detail ?? {};
              for (const row of rows) {
                const value = latest[row.dataset.key]?.uploadedAt;
                const date = value ? new Date(value) : null;
                if (date && !Number.isNaN(date.getTime())) row.dataset.updated = date.toISOString();
              }
              apply();
            });

            apply();
          })();
        </script>
      </div>
    ) : (
      <>
        <header class="game-intro">
          <h1>{game.name}</h1>
        </header>
        <div class="cards">
          {gameMods.map((mod) => (
            <a class="mod-card" style={heroVars(mod.slug)} href={`/${game.slug}/${mod.slug}`}>
              <span class="mark">{lookFor(mod.slug).mark}</span>
              <strong>{mod.name}</strong>
              <span class="ver"><span data-latest={`${mod.game}/${mod.slug}`} data-latest-field="version">{mod.version}</span></span>
              <p>{mod.description}</p>
            </a>
          ))}
        </div>
      </>
    )
  }
</Base>
