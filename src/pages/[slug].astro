---
import Base from "../layouts/Base.astro";
import ModList from "../components/ModList.astro";
import StoreCounts from "../components/StoreCounts.astro";
import { games } from "../data/games";
import { modsForGame, r2Download, uploadedOn } from "../data/mods";
import { featuredOrder, hubIndex, hubInfo, type ModRow } from "../data/hub-index";
import { indexInfo, sevendaysCategories } from "../data/sevendays-index";
import { heroVars, lookFor } from "../data/themes";

export function getStaticPaths() {
  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const gameMods = modsForGame(game.slug);
const rimworld = game.slug === "rimworld";
const sunhaven = game.slug === "sun-haven";
const sevendays = game.slug === "7-days-to-die";
const hub = rimworld || sunhaven || sevendays;
const rows: ModRow[] = sevendays
  ? [...gameMods]
      .sort((a, b) => a.name.localeCompare(b.name))
      .map((mod) => {
        const info = indexInfo(mod);
        return { mod, category: info.category, short: info.short, installs: info.installs, direct: r2Download(mod), updated: uploadedOn(mod) };
      })
  : featuredOrder(game.slug, gameMods).map((mod) => {
      const info = hubInfo(mod);
      // Azrael's preview file is the Homesteader poster, so its row shows no picture.
      const thumb = rimworld && mod.slug !== "azrael" ? mod.images[0] : undefined;
      return { mod, category: info.category, short: info.short, thumb, direct: r2Download(mod), updated: uploadedOn(mod) };
    });
---

<Base title={`${game.name} mods`} description={`Mods for ${game.name}.`} game={game.slug}>
  {
    hub ? (
      <div class:list={["zd-hub", rimworld && "ml-rimworld", sunhaven && "ml-sunhaven"]}>
        <header class="zd-hero">
          {rimworld ? (
            <>
              <p class="zd-kicker">RimWorld</p>
              <h1>RimWorld Mods</h1>
              <p>
                {rows.length} mods for colonies that farm, harden, dig, remember, make time for each other, and keep the small comforts.
              </p>
            </>
          ) : sunhaven ? (
            <>
              <p class="zd-kicker">BepInEx plugins for Sun Haven</p>
              <h1>
                Every day in Haven, <em>a little brighter.</em>
              </h1>
              <p>
                {rows.length} quality-of-life mods. Each one stands alone, and they work better together.
              </p>
            </>
          ) : (
            <>
              <p class="zd-kicker">7 Days to Die</p>
              <h1>After dark.</h1>
              <p>
                {rows.length} mods for the horde. Search, filter by what you need, and see at a glance whether it goes on the server, your game, or both.
              </p>
            </>
          )}
          <StoreCounts game={game.slug} variant="hero" />
        </header>
        <div class="zd-hazard" aria-hidden="true"></div>
        <ModList
          game={game.slug}
          gameName={game.name}
          rows={rows}
          categories={sevendays ? sevendaysCategories : (hubIndex[game.slug]?.categories ?? [])}
          featured={!sevendays}
          countField={rimworld ? "steam" : sunhaven ? "combined" : "nexus"}
          countLabel={rimworld ? "Subscribers" : "Downloads"}
        />
      </div>
    ) : (
      <>
        <header class="game-intro">
          <h1>{game.name}</h1>
        </header>
        <div class="cards">
          {gameMods.map((mod) => (
            <a class="mod-card" style={heroVars(mod.slug)} href={`/${game.slug}/${mod.slug}`}>
              <span class="mark">{lookFor(mod.slug).mark}</span>
              <strong>{mod.name}</strong>
              <span class="ver"><span data-latest={`${mod.game}/${mod.slug}`} data-latest-field="version">{mod.version}</span></span>
              <p>{mod.description}</p>
            </a>
          ))}
        </div>
      </>
    )
  }
</Base>
