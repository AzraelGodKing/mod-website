---
import Base from "../layouts/Base.astro";
import { games } from "../data/games";
import { mods, modsForGame } from "../data/mods";

// Every mod, so the page can suggest the one an old or mistyped link meant.
const index = mods.map((mod) => ({
  n: mod.name,
  g: games.find((game) => game.slug === mod.game)?.name ?? mod.game,
  u: `/${mod.game}/${mod.slug}`,
  s: mod.slug,
}));
---

<Base title="Page not found" description="That page is not on this site." noindex>
  <section class="plain-page not-found">
    <p class="not-found-code">404</p>
    <h1>Page not found</h1>
    <p>That page is not here. The mod may have moved or been renamed.</p>
    <div class="not-found-guess" id="not-found-guess" hidden>
      <h2>Did you mean</h2>
      <ul class="plain-links" id="not-found-list"></ul>
    </div>
    <form class="not-found-search" action="/" method="get" role="search">
      <label for="not-found-q">Search every mod</label>
      <div>
        <input id="not-found-q" name="q" type="search" placeholder="Mod name or what it does" autocomplete="off" />
        <button type="submit">Search</button>
      </div>
    </form>
    <h2>Or pick a catalog</h2>
    <ul class="plain-links">
      {
        games.map((game) => (
          <li>
            <a href={`/${game.slug}`}>{game.name}</a> <span>{modsForGame(game.slug).length} mods</span>
          </li>
        ))
      }
    </ul>
    <p><a href="/">Back to the home page</a></p>
  </section>
  <script is:inline type="application/json" id="not-found-index" set:html={JSON.stringify(index).replace(/</g, "\\u003c")} />
  <script is:inline>
    (() => {
      // Compare the missing address with every mod by shared letter pairs, so
      // "/rimworld/livingworld" or "/7-days-to-die/blood-moon" still finds its page.
      const data = JSON.parse(document.getElementById("not-found-index")?.textContent || "[]");
      const clean = (text) => text.toLowerCase().replace(/[^a-z0-9]/g, "");
      const pairs = (text) => {
        const out = new Map();
        for (let at = 0; at < text.length - 1; at++) {
          const pair = text.slice(at, at + 2);
          out.set(pair, (out.get(pair) ?? 0) + 1);
        }
        return out;
      };
      const similar = (a, b) => {
        if (!a || !b) return 0;
        if (a === b) return 1;
        const left = pairs(a);
        const right = pairs(b);
        let shared = 0;
        for (const [pair, count] of left) shared += Math.min(count, right.get(pair) ?? 0);
        return (2 * shared) / (Math.max(a.length - 1, 1) + Math.max(b.length - 1, 1));
      };
      const parts = location.pathname.split("/").filter(Boolean).map(decodeURIComponent);
      const wanted = clean(parts.at(-1) ?? "");
      if (!wanted) return;
      const hits = data
        .map((mod) => ({ mod, score: Math.max(similar(wanted, clean(mod.s)), similar(wanted, clean(mod.n))) + (parts[0] && mod.u.startsWith(`/${parts[0]}/`) ? 0.05 : 0) }))
        .filter((hit) => hit.score >= 0.45)
        .sort((a, b) => b.score - a.score)
        .slice(0, 3);
      const search = document.getElementById("not-found-q");
      if (search) search.value = parts.at(-1).replace(/[-_]+/g, " ");
      if (hits.length === 0) return;
      const list = document.getElementById("not-found-list");
      for (const { mod } of hits) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = mod.u;
        a.textContent = mod.n;
        const span = document.createElement("span");
        span.textContent = mod.g;
        li.append(a, " ", span);
        list.append(li);
      }
      document.getElementById("not-found-guess").hidden = false;
    })();
  </script>
</Base>
