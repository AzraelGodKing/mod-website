---
import Base from "../layouts/Base.astro";
import "../styles/admin.css";
import { games } from "../data/games";
import { mods, modsForGame } from "../data/mods";
import { platforms } from "../data/stats";
import { TOOLS, releasesPage } from "../downloads/tools.mjs";
import { ADMIN_SITES } from "../data/links.mjs";

type Column = { field: string; label: string };

function columns(game: string): Column[] {
  const list: Column[] = [{ field: "site", label: "This site" }];
  for (const platform of platforms[game] ?? []) {
    if (platform === "steam") list.push({ field: "steam", label: "Steam subs" });
    if (platform === "thunderstore") list.push({ field: "thunderstore", label: "Thunderstore" });
    if (platform === "nexus") {
      list.push({ field: "nexus", label: "Nexus" }, { field: "nexus_unique", label: "Nexus unique" });
    }
  }
  return list;
}

function totals(game: string): Column[] {
  const list = columns(game);
  list.unshift({ field: "total", label: "All downloads" });
  if (game === "sun-haven") list.splice(2, 0, { field: "combined", label: "Thunderstore + Nexus" });
  return list;
}

const tabs = [
  ["overview", "Overview"],
  ["downloads", "Downloads"],
  ["releases", "Releases"],
  ["activity", "Activity"],
  ["history", "History"],
  ["supporters", "Supporters"],
  ["requests", "Requests"],
  ["signin", "Sign-in"],
];

// Names for keys the API returns ("<game>/<mod>"), so Activity and Releases can show them.
const names = Object.fromEntries(mods.map((mod) => [`${mod.game}/${mod.slug}`, mod.name]));
const gameNames = Object.fromEntries(games.map((game) => [game.slug, game.name]));
const csvColumns = [...new Set(games.flatMap((game) => columns(game.slug).map((column) => column.field)))];

const links = [
  ["Cloudflare dashboard", "https://dash.cloudflare.com/"],
  ["Public stats API", "/api/stats"],
  ["Live downloads API", "/api/downloads"],
  ["downloads.json", "https://downloads.azraelsmods.com/downloads.json"],
  ["Kat's RICS upload", "https://kats.azraelsmods.com/upload"],
  ["Website repo", "https://github.com/AzraelGodKing/mod-website"],
  ...games.map((game) => [`${game.name} repo`, game.repo]),
];
---

<Base title="Admin · Azrael's Mods" description="Site admin." admin>
  <div class="adm">
    <header class="adm-hero">
      <p class="adm-kicker">Azrael's Mods · Admin</p>
      <h1>Dashboard</h1>
      <p class="adm-lede" id="adm-greeting">Download counters, releases, and sign-in in one place.</p>
    </header>
    <div class="adm-strip" aria-hidden="true"></div>

    <div class="adm-login" id="admin-login" hidden>
      <div class="adm-login-card">
        <svg class="adm-lock" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="4.5" y="10.5" width="15" height="10" rx="1.5"></rect>
          <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"></path>
        </svg>
        <h2>Sign in</h2>
        <p class="adm-muted">This page is only for running the site.</p>
        <button type="button" class="adm-btn is-primary adm-wide" id="admin-passkey-login" hidden>Sign in with a passkey</button>
        <p class="adm-or" id="admin-or" hidden><span>or</span></p>
        <form class="adm-password" id="admin-password-login" hidden>
          <label>
            <span>Password</span>
            <input name="password" type="password" autocomplete="current-password" required />
          </label>
          <button type="submit" class="adm-btn">Open</button>
        </form>
        <p class="adm-error" id="admin-login-error" role="alert"></p>
      </div>
    </div>

    <section class="adm-body" id="admin-body" hidden>
      <div class="adm-bar">
        <dl class="adm-times">
          <div>
            <dt>Last refresh</dt>
            <dd id="admin-last">—</dd>
          </div>
          <div>
            <dt>Last hourly</dt>
            <dd id="admin-hourly">—</dd>
          </div>
          <div>
            <dt>Next hourly</dt>
            <dd id="admin-next">—</dd>
          </div>
        </dl>
        <div class="adm-actions">
          <button type="button" class="adm-btn is-primary" id="admin-refresh">Refresh now</button>
          <button type="button" class="adm-btn" id="admin-export">Export CSV</button>
          <button type="button" class="adm-btn is-quiet" id="admin-logout">Sign out</button>
        </div>
      </div>
      <p class="adm-status" id="admin-status" role="status"></p>
      <ul class="adm-warnings" id="admin-warnings" hidden></ul>

      <nav class="adm-tabs" role="tablist" aria-label="Admin sections">
        {
          tabs.map(([id, label]) => (
            <button type="button" role="tab" id={`tab-${id}`} aria-controls={`panel-${id}`} data-tab={id}>
              {label}
              {id === "releases" && <span class="adm-badge" id="adm-release-badge" hidden></span>}
            </button>
          ))
        }
      </nav>

      <section class="adm-panel" role="tabpanel" id="panel-overview" aria-labelledby="tab-overview" data-panel="overview">
        <div class="adm-tiles">
          <div class="adm-tile is-lead">
            <span class="adm-tile-label">All downloads</span>
            <strong id="adm-sum-total">—</strong>
            <span class="adm-tile-note">This site, Thunderstore, and Nexus</span>
          </div>
          <div class="adm-tile">
            <span class="adm-tile-label">This site</span>
            <strong id="adm-sum-site">—</strong>
            <span class="adm-tile-note">Download button clicks</span>
          </div>
          <div class="adm-tile">
            <span class="adm-tile-label">Steam subscribers</span>
            <strong id="adm-sum-steam">—</strong>
            <span class="adm-tile-note">Counted on their own</span>
          </div>
          <div class="adm-tile">
            <span class="adm-tile-label">Mods listed</span>
            <strong>{mods.length}</strong>
            <span class="adm-tile-note">{games.length} games</span>
          </div>
        </div>

        <div class="adm-games">
          {
            games.map((game) => (
              <a class="adm-game-card" href="#downloads" data-jump-game={game.slug} data-game={game.slug}>
                <span class="adm-game-name">{game.name}</span>
                <strong data-overview-game={game.slug}>—</strong>
                <span class="adm-tile-note">
                  {modsForGame(game.slug).length} mods · top: <span data-top-mod={game.slug}>—</span>
                </span>
              </a>
            ))
          }
        </div>

        <section class="adm-tools" aria-labelledby="adm-tools-title">
          <h2 id="adm-tools-title">Tools</h2>
          <div class="adm-games">
            {
              TOOLS.map((tool) => (
                <a class="adm-game-card" href={releasesPage(tool)} target="_blank" rel="noopener" data-game={tool.game} data-tool={tool.slug}>
                  <span class="adm-game-name">{tool.name}</span>
                  <strong data-tool-downloads>—</strong>
                  <span class="adm-tile-note">
                    {gameNames[tool.game] ?? tool.game} · downloads from this site
                  </span>
                  <span class="adm-tile-note" data-tool-github>GitHub: checking…</span>
                  <span class="adm-tool-release">
                    <span class="adm-pill is-muted" data-tool-version>Checking…</span>
                    <span class="adm-tile-note" data-tool-released></span>
                  </span>
                  <table class="adm-tool-versions" data-tool-versions hidden>
                    <thead>
                      <tr><th scope="col">Version</th><th scope="col">This site</th><th scope="col">GitHub</th></tr>
                    </thead>
                    <tbody></tbody>
                  </table>
                </a>
              ))
            }
          </div>
        </section>

        <section class="adm-tools adm-sites" aria-labelledby="adm-sites-title">
          <h2 id="adm-sites-title">Sites</h2>
          <div class="adm-games">
            {
              ADMIN_SITES.map((site) => (
                <a class="adm-game-card" href={site.href} target="_blank" rel="noopener" data-site-status={site.status ?? undefined}>
                  <span class="adm-game-name">{site.name}</span>
                  <span class="adm-site-host">{new URL(site.href).host}</span>
                  <span class="adm-tile-note">{site.note}</span>
                  {site.status && (
                    <span class="adm-tool-release">
                      <span class="adm-pill is-muted" data-site-pill>Checking…</span>
                    </span>
                  )}
                </a>
              ))
            }
          </div>
        </section>

        <div class="adm-split">
          <section class="adm-card">
            <h2>Health</h2>
            <ul class="adm-checks" id="adm-checks">
              <li><span class="adm-dot"></span>Checking…</li>
            </ul>
          </section>
          <section class="adm-card">
            <h2>Shortcuts</h2>
            <ul class="adm-links">
              {
                links.map(([label, href]) => (
                  <li>
                    <a href={href} target={href.startsWith("http") ? "_blank" : undefined} rel="noopener">
                      {label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>
        </div>
      </section>

      <section class="adm-panel" role="tabpanel" id="panel-downloads" aria-labelledby="tab-downloads" data-panel="downloads" hidden>
        <div class="adm-toolbar">
          <label class="adm-search">
            <span class="sr-only">Find a mod</span>
            <input id="adm-search" type="search" placeholder="Find a mod…" autocomplete="off" />
          </label>
          <div class="adm-chips" role="group" aria-label="Game">
            <button type="button" class="adm-chip is-on" data-game-filter="" aria-pressed="true">All games</button>
            {
              games.map((game) => (
                <button type="button" class="adm-chip" data-game-filter={game.slug} aria-pressed="false">
                  {game.name}
                </button>
              ))
            }
          </div>
        </div>
        {
          games.map((game) => (
            <section class="adm-game" data-game={game.slug}>
              <h2>{game.name}</h2>
              <dl class="adm-totals" data-admin-game={game.slug}>
                {totals(game.slug).map((column) => (
                  <div>
                    <dt>{column.label}</dt>
                    <dd data-field={column.field}>—</dd>
                  </div>
                ))}
              </dl>
              <div class="adm-table-wrap">
                <table class="adm-table">
                  <thead>
                    <tr>
                      <th scope="col">
                        <button type="button" data-sort="name">Mod</button>
                      </th>
                      {columns(game.slug).map((column) => (
                        <th scope="col">
                          <button type="button" data-sort={column.field}>{column.label}</button>
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {modsForGame(game.slug).map((mod) => (
                      <tr data-admin-mod={`${game.slug}/${mod.slug}`} data-name={mod.name.toLowerCase()}>
                        <th scope="row">
                          <a href={`/${game.slug}/${mod.slug}`}>{mod.name}</a>
                          <span class="adm-ver">v{mod.version}</span>
                        </th>
                        {columns(game.slug).map((column) => (
                          <td data-field={column.field}>—</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          ))
        }
        <p class="adm-empty" id="adm-search-empty" hidden>No mods match.</p>
      </section>

      <section class="adm-panel" role="tabpanel" id="panel-releases" aria-labelledby="tab-releases" data-panel="releases" hidden>
        <div class="adm-toolbar">
          <p class="adm-muted">
            The version each page was built with next to what <code>downloads.json</code> holds right now. A newer upload
            shows on the site without a rebuild.
          </p>
          <div class="adm-filters">
            <label class="adm-select">
              <span>Game</span>
              <select id="adm-release-game">
                <option value="">All games</option>
                {games.map((game) => <option value={game.slug}>{game.name}</option>)}
              </select>
            </label>
            <label class="adm-select">
              <span>Status</span>
              <select id="adm-release-status">
                <option value="">All statuses</option>
                <option value="attention">Needs attention</option>
              </select>
            </label>
          </div>
        </div>
        <div class="adm-table-wrap">
          <table class="adm-table is-left">
            <thead>
              <tr>
                <th scope="col">Mod</th>
                <th scope="col">Game</th>
                <th scope="col">Site build</th>
                <th scope="col">downloads.json</th>
                <th scope="col">Uploaded</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody id="adm-releases">
              <tr><td colspan="6" class="adm-muted">Loading…</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="adm-panel" role="tabpanel" id="panel-activity" aria-labelledby="tab-activity" data-panel="activity" hidden>
        <div class="adm-toolbar">
          <p class="adm-muted">Clicks on this site's Download buttons, per mod and version, newest first. Bots are skipped.</p>
        </div>
        <div class="adm-table-wrap">
          <table class="adm-table is-left">
            <thead>
              <tr>
                <th scope="col">Mod</th>
                <th scope="col">Game</th>
                <th scope="col">Version</th>
                <th scope="col" class="is-num">Clicks</th>
                <th scope="col">Last click</th>
              </tr>
            </thead>
            <tbody id="adm-activity">
              <tr><td colspan="5" class="adm-muted">Loading…</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="adm-panel" role="tabpanel" id="panel-history" aria-labelledby="tab-history" data-panel="history" hidden>
        <div class="adm-toolbar">
          <label class="adm-select">
            <span>Show</span>
            <select id="adm-history-scope">
              <option value="">All mods</option>
              {
                games.map((game) => (
                  <optgroup label={game.name}>
                    <option value={`game:${game.slug}`}>All {game.name} mods</option>
                    {modsForGame(game.slug).map((mod) => (
                      <option value={`${mod.game}/${mod.slug}`}>{mod.name}</option>
                    ))}
                  </optgroup>
                ))
              }
            </select>
          </label>
          <div class="adm-chips" role="group" aria-label="Time range">
            {[7, 30, 90].map((days) => (
              <button type="button" class:list={["adm-chip", days === 30 && "is-on"]} data-history-days={days} aria-pressed={days === 30 ? "true" : "false"}>
                {days} days
              </button>
            ))}
          </div>
        </div>
        <p class="adm-muted">
          Daily counts, in UTC days. Site clicks are this site's Download buttons. Store downloads are the daily gain on
          Thunderstore and Nexus, read by the hourly refresh. History starts on the day this tab went live.
        </p>
        <div class="adm-charts">
          <figure class="adm-card adm-chart" data-chart="site">
            <figcaption>
              <h2>Site clicks per day</h2>
              <p class="adm-chart-total" data-chart-total>—</p>
            </figcaption>
            <div class="adm-chart-plot" data-chart-plot></div>
          </figure>
          <figure class="adm-card adm-chart" data-chart="store">
            <figcaption>
              <h2>Store downloads per day</h2>
              <p class="adm-chart-total" data-chart-total>—</p>
            </figcaption>
            <div class="adm-chart-plot" data-chart-plot></div>
          </figure>
        </div>
        <details class="adm-history-table">
          <summary>Show as a table</summary>
          <div class="adm-table-wrap">
            <table class="adm-table">
              <thead>
                <tr>
                  <th scope="col" class="is-left">Day</th>
                  <th scope="col" class="is-num">Site clicks</th>
                  <th scope="col" class="is-num">Store downloads</th>
                </tr>
              </thead>
              <tbody id="adm-history-rows">
                <tr><td colspan="3" class="adm-muted">Loading…</td></tr>
              </tbody>
            </table>
          </div>
        </details>
      </section>

      <section class="adm-panel" role="tabpanel" id="panel-supporters" aria-labelledby="tab-supporters" data-panel="supporters" hidden>
        <div class="adm-toolbar">
          <p class="adm-muted">
            Everyone Ko-fi has told the site about, private ones and amounts included. The public{" "}
            <a href="/donors">Supporters page</a> only names people who left their support public, and never shows amounts.
          </p>
        </div>
        <p class="adm-warnings" id="adm-kofi-missing" hidden>
          KOFI_VERIFICATION_TOKEN is not set, so Ko-fi's posts to /api/kofi are refused. See docs/DONORS.md.
        </p>
        <div class="adm-table-wrap">
          <table class="adm-table is-left adm-donors-table">
            <thead>
              <tr>
                <th scope="col">Name</th>
                <th scope="col">Message</th>
                <th scope="col">Kind</th>
                <th scope="col" class="is-num">Amount</th>
                <th scope="col">When</th>
                <th scope="col"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody id="adm-donors">
              <tr><td colspan="6" class="adm-muted">Loading…</td></tr>
            </tbody>
          </table>
        </div>
        <p class="adm-status" id="adm-donor-status" role="status"></p>
        <section class="adm-card">
          <h2>Add a supporter by hand</h2>
          <p class="adm-muted">For someone who gave before the Ko-fi webhook was set up, or somewhere else.</p>
          <form class="adm-donor-add" id="adm-donor-add">
            <label>
              <span>Name</span>
              <input name="name" type="text" maxlength="80" required />
            </label>
            <label>
              <span>Date</span>
              <input name="date" type="date" />
            </label>
            <label>
              <span>Amount (admin only)</span>
              <input name="amount" type="text" maxlength="20" placeholder="5.00 USD" />
            </label>
            <label class="adm-donor-message">
              <span>Message (optional, shown on the page)</span>
              <input name="message" type="text" maxlength="500" />
            </label>
            <label class="adm-check">
              <input name="isPublic" type="checkbox" checked />
              Show their name on the page
            </label>
            <button type="submit" class="adm-btn is-primary">Add supporter</button>
          </form>
        </section>
      </section>

      <section class="adm-panel" role="tabpanel" id="panel-requests" aria-labelledby="tab-requests" data-panel="requests" hidden>
        <div class="adm-toolbar">
          <p class="adm-muted">
            What visitors asked for on the <a href="/requests">Mod requests page</a>. A new request stays off that page until you
            set it to Open. Declined ones stay hidden. The note shows under the request as your reply.
          </p>
        </div>
        <div class="adm-table-wrap">
          <table class="adm-table is-left adm-requests-table">
            <thead>
              <tr>
                <th scope="col">Request</th>
                <th scope="col">Game</th>
                <th scope="col" class="is-num">Votes</th>
                <th scope="col">When</th>
                <th scope="col">Status</th>
                <th scope="col">Your note</th>
                <th scope="col"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody id="adm-requests">
              <tr><td colspan="7" class="adm-muted">Loading…</td></tr>
            </tbody>
          </table>
        </div>
        <p class="adm-status" id="adm-request-status" role="status"></p>
      </section>

      <section class="adm-panel" role="tabpanel" id="panel-signin" aria-labelledby="tab-signin" data-panel="signin" hidden>
        <div class="adm-split">
          <section class="adm-card">
            <h2>Passkeys</h2>
            <p class="adm-muted">
              Sign in with a passkey from your password manager. Once one works, you can remove the ADMIN_TOKEN secret to
              turn password sign-in off.
            </p>
            <ul class="adm-passkeys" id="admin-passkey-list"></ul>
            <form class="adm-passkey-add" id="admin-passkey-add">
              <label>
                <span>Name</span>
                <input name="name" type="text" maxlength="60" placeholder="LastPass" />
              </label>
              <button type="submit" class="adm-btn is-primary">Add passkey</button>
            </form>
            <p class="adm-status" id="admin-passkey-status" role="status"></p>
          </section>
          <section class="adm-card">
            <h2>Sessions</h2>
            <p class="adm-muted">Each sign-in lasts 12 hours. Signing out everywhere ends every session, this one too.</p>
            <p class="adm-session-count"><strong id="adm-sessions">—</strong> <span id="adm-sessions-label">active sessions</span></p>
            <button type="button" class="adm-btn is-danger" id="adm-signout-all">Sign out everywhere</button>
          </section>
        </div>

        <section class="adm-card adm-sessions-card">
          <h2>Active sessions</h2>
          <p class="adm-muted">One row per signed-in browser. Sign one out if you don't recognise it.</p>
          <div class="adm-table-wrap">
            <table class="adm-table is-left adm-sessions-table">
              <thead>
                <tr>
                  <th scope="col">Device</th>
                  <th scope="col">Signed in with</th>
                  <th scope="col">Signed in</th>
                  <th scope="col">Last active</th>
                  <th scope="col">Ends</th>
                  <th scope="col"><span class="sr-only">Actions</span></th>
                </tr>
              </thead>
              <tbody id="adm-session-rows">
                <tr><td colspan="6" class="adm-muted">Loading…</td></tr>
              </tbody>
            </table>
          </div>
          <p class="adm-status" id="adm-session-status" role="status"></p>
        </section>
      </section>
    </section>
  </div>

  <script type="application/json" id="adm-data" set:html={JSON.stringify({ names, gameNames, csvColumns })} />

  <script is:inline>
    (() => {
      const $ = (selector) => document.querySelector(selector);
      const login = $("#admin-login");
      const loginError = $("#admin-login-error");
      const passkeyLogin = $("#admin-passkey-login");
      const passwordLogin = $("#admin-password-login");
      const loginOr = $("#admin-or");
      const body = $("#admin-body");
      const status = $("#admin-status");
      const warnings = $("#admin-warnings");
      const refreshButton = $("#admin-refresh");
      const passkeyList = $("#admin-passkey-list");
      const passkeyAdd = $("#admin-passkey-add");
      const passkeyStatus = $("#admin-passkey-status");
      const { names, gameNames, csvColumns } = JSON.parse($("#adm-data").textContent);
      const sources = { scheduled: "hourly", manual: "manual", "first-request": "first visit" };
      const passkeysSupported = typeof window.PublicKeyCredential === "function";
      let snapshot = null;

      const format = (value) => (typeof value === "number" ? value.toLocaleString("en-US") : "—");
      const when = (iso) => (iso ? new Date(iso).toLocaleString() : "—");

      function ago(iso) {
        if (!iso) return "—";
        const seconds = Math.round((Date.now() - new Date(iso).getTime()) / 1000);
        const abs = Math.abs(seconds);
        if (abs < 30) return "just now";
        const [amount, unit] =
          abs < 3600 ? [Math.round(abs / 60), "min"] : abs < 86400 ? [Math.round(abs / 3600), "h"] : [Math.round(abs / 86400), "d"];
        return seconds < 0 ? `in ${amount} ${unit}` : `${amount} ${unit} ago`;
      }

      function stamp(element, iso, extra = "") {
        element.textContent = iso ? `${ago(iso)}${extra}` : "—";
        element.title = when(iso);
      }

      function nextHourly() {
        const next = new Date();
        next.setUTCMinutes(17, 0, 0);
        if (next <= new Date()) next.setUTCHours(next.getUTCHours() + 1);
        return next.toISOString();
      }

      function stampTimes() {
        stamp($("#admin-last"), snapshot.lastFetched, ` · ${sources[snapshot.source] ?? snapshot.source ?? "unknown"}`);
        stamp($("#admin-hourly"), snapshot.lastScheduled);
        stamp($("#admin-next"), nextHourly());
      }

      function greet() {
        const hour = new Date().getHours();
        const part = hour < 5 ? "Up late" : hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
        $("#adm-greeting").textContent = `${part}, Azrael. Here is how the mods are doing.`;
      }

      // ---- Tabs ----
      const tabButtons = [...document.querySelectorAll("[data-tab]")];
      const panels = [...document.querySelectorAll("[data-panel]")];
      const loaded = new Set();
      function showTab(id, remember = true) {
        if (!tabButtons.some((button) => button.dataset.tab === id)) id = "overview";
        for (const button of tabButtons) button.setAttribute("aria-selected", String(button.dataset.tab === id));
        for (const panel of panels) panel.hidden = panel.dataset.panel !== id;
        if (remember) history.replaceState(null, "", `#${id}`);
        if (!body.hidden) loadTab(id);
      }
      function loadTab(id) {
        if (loaded.has(id)) return;
        loaded.add(id);
        if (id === "releases") loadReleases();
        if (id === "activity") loadActivity();
        if (id === "history") loadHistory();
        if (id === "supporters") loadDonors();
        if (id === "requests") loadRequests();
      }
      for (const button of tabButtons) button.addEventListener("click", () => showTab(button.dataset.tab));
      for (const card of document.querySelectorAll("[data-jump-game]")) {
        card.addEventListener("click", (event) => {
          event.preventDefault();
          filterGame(card.dataset.jumpGame);
          showTab("downloads");
        });
      }

      // ---- Downloads ----
      function modValues(key) {
        const mod = snapshot?.mods?.[key] ?? {};
        return {
          site: mod.site?.downloads,
          steam: mod.steam?.subscriptions,
          thunderstore: mod.thunderstore?.downloads,
          nexus: mod.nexus?.downloads,
          nexus_unique: mod.nexus?.unique,
        };
      }

      function render(next) {
        snapshot = next;
        stampTimes();

        warnings.replaceChildren(
          ...(snapshot.warnings ?? []).map((message) => {
            const item = document.createElement("li");
            item.textContent = message;
            return item;
          }),
        );
        warnings.hidden = warnings.children.length === 0;

        const sums = { total: 0, site: 0, steam: 0 };
        for (const [game, stats] of Object.entries(snapshot.games ?? {})) {
          for (const field of Object.keys(sums)) if (typeof stats?.[field] === "number") sums[field] += stats[field];
          for (const cell of document.querySelectorAll(`[data-overview-game="${game}"]`)) cell.textContent = format(stats?.total);
        }
        $("#adm-sum-total").textContent = format(sums.total);
        $("#adm-sum-site").textContent = format(sums.site);
        $("#adm-sum-steam").textContent = format(sums.steam);

        for (const list of document.querySelectorAll("[data-admin-game]")) {
          const totals = snapshot.games?.[list.dataset.adminGame] ?? {};
          for (const cell of list.querySelectorAll("[data-field]")) cell.textContent = format(totals[cell.dataset.field]);
        }

        const top = {};
        for (const row of document.querySelectorAll("[data-admin-mod]")) {
          const values = modValues(row.dataset.adminMod);
          for (const cell of row.querySelectorAll("[data-field]")) {
            const value = values[cell.dataset.field];
            cell.textContent = format(value);
            cell.dataset.value = typeof value === "number" ? value : -1;
            cell.classList.toggle("is-zero", !value);
          }
          const [game] = row.dataset.adminMod.split("/");
          const score = (values.site ?? 0) + (values.thunderstore ?? 0) + (values.nexus ?? 0) + (values.steam ?? 0);
          if (!top[game] || score > top[game].score) top[game] = { score, name: names[row.dataset.adminMod] };
        }
        for (const cell of document.querySelectorAll("[data-top-mod]")) {
          cell.textContent = top[cell.dataset.topMod]?.score ? top[cell.dataset.topMod].name : "—";
        }
        markLeaders();
        renderToolCounts();
      }

      // ---- Sites: up or down, from status.azraelsmods.com ----
      (function loadSiteStatus() {
        const cards = document.querySelectorAll("[data-site-status]");
        if (!cards.length) return;
        const LABEL = { up: ["Up", "is-ok"], degraded: ["Partly up", "is-warn"], down: ["Down", "is-bad"], unknown: ["Not checked yet", "is-muted"] };
        const paint = (card, status) => {
          const pill = card.querySelector("[data-site-pill]");
          const [text, cls] = LABEL[status] ?? ["Status unavailable", "is-muted"];
          pill.textContent = text;
          pill.className = `adm-pill ${cls}`;
        };
        fetch("https://status.azraelsmods.com/api/status")
          .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
          .then((data) => {
            const byId = Object.fromEntries((data.services ?? []).map((service) => [service.id, service.status]));
            for (const card of cards) {
              const id = card.dataset.siteStatus;
              paint(card, id === "overall" ? data.overall : byId[id]);
            }
          })
          .catch(() => cards.forEach((card) => paint(card, null)));
      })();

      // ---- Tools ----
      // Counts come with the stats; versions come from GitHub with the overview.
      function renderToolCounts() {
        for (const card of document.querySelectorAll("[data-tool]")) {
          card.querySelector("[data-tool-downloads]").textContent = format(snapshot?.tools?.[`tools/${card.dataset.tool}`]?.downloads);
        }
      }
      // GitHub counts every download of the release files, from this site or not.
      // The table puts this site's clicks for each version next to GitHub's count.
      function renderToolVersions(card, entry) {
        const github = entry?.github;
        const note = card.querySelector("[data-tool-github]");
        note.textContent = github ? `GitHub: ${format(github.total)} downloads, every version` : "GitHub counts unavailable";
        const site = Object.fromEntries((entry?.site ?? []).map((row) => [row.version, row.count]));
        const versions = [...new Set([...Object.keys(site), ...Object.keys(github?.versions ?? {})])]
          .sort((a, b) => compareVersions(b, a))
          .slice(0, 6);
        const table = card.querySelector("[data-tool-versions]");
        table.hidden = versions.length === 0;
        table.tBodies[0].replaceChildren(
          ...versions.map((version) => {
            const row = document.createElement("tr");
            for (const text of [`v${version}`, format(site[version] ?? 0), github ? format(github.versions[version] ?? 0) : "—"]) {
              const cell = document.createElement("td");
              cell.textContent = text;
              row.append(cell);
            }
            return row;
          }),
        );
      }
      function compareVersions(a, b) {
        const pa = a.split(/[.-]/).map((part) => Number(part) || 0);
        const pb = b.split(/[.-]/).map((part) => Number(part) || 0);
        for (let i = 0; i < Math.max(pa.length, pb.length); i += 1) {
          const diff = (pa[i] ?? 0) - (pb[i] ?? 0);
          if (diff) return diff;
        }
        return 0;
      }
      function renderToolReleases(tools) {
        let missing = 0;
        for (const card of document.querySelectorAll("[data-tool]")) {
          const release = tools?.find((tool) => tool.slug === card.dataset.tool)?.release;
          const version = card.querySelector("[data-tool-version]");
          const released = card.querySelector("[data-tool-released]");
          if (!release) missing += 1;
          version.className = `adm-pill ${release ? "is-ok" : "is-warn"}`;
          version.textContent = release ? `v${release.version}` : "No release found";
          released.textContent = release?.publishedAt ? `released ${ago(release.publishedAt)}` : "";
          released.title = when(release?.publishedAt);
          if (release?.notes) card.href = release.notes;
          renderToolVersions(card, tools?.find((tool) => tool.slug === card.dataset.tool));
        }
        setCheck("tools", missing === 0, missing === 0 ? "Tool releases are on GitHub" : `${missing} tool${missing === 1 ? "" : "s"} have no GitHub release`);
      }

      // The biggest number in each column gets a highlight.
      function markLeaders() {
        for (const table of document.querySelectorAll(".adm-game table")) {
          const best = {};
          for (const cell of table.querySelectorAll("tbody td[data-field]")) {
            const value = Number(cell.dataset.value);
            if (value > 0 && value > (best[cell.dataset.field]?.value ?? 0)) best[cell.dataset.field] = { value, cell };
            cell.classList.remove("is-best");
          }
          for (const { cell } of Object.values(best)) cell.classList.add("is-best");
        }
      }

      // Numbers sort biggest first on the first click, names A to Z.
      for (const table of document.querySelectorAll(".adm-game table")) {
        const tbody = table.querySelector("tbody");
        for (const button of table.querySelectorAll("[data-sort]")) {
          button.addEventListener("click", () => {
            const field = button.dataset.sort;
            const first = field === "name" ? "ascending" : "descending";
            const current = button.getAttribute("aria-sort");
            const order = current === first ? (first === "ascending" ? "descending" : "ascending") : first;
            for (const other of table.querySelectorAll("[data-sort]")) other.removeAttribute("aria-sort");
            button.setAttribute("aria-sort", order);
            const direction = order === "ascending" ? 1 : -1;
            const value = (row) => Number(row.querySelector(`[data-field="${field}"]`)?.dataset.value ?? -1);
            const rows = [...tbody.rows].sort((a, b) =>
              field === "name"
                ? direction * a.dataset.name.localeCompare(b.dataset.name)
                : direction * (value(a) - value(b)) || a.dataset.name.localeCompare(b.dataset.name),
            );
            tbody.append(...rows);
          });
        }
      }

      const search = $("#adm-search");
      const chips = [...document.querySelectorAll("[data-game-filter]")];
      let gameFilter = "";
      function filterGame(game) {
        gameFilter = game;
        for (const chip of chips) {
          const on = chip.dataset.gameFilter === game;
          chip.classList.toggle("is-on", on);
          chip.setAttribute("aria-pressed", String(on));
        }
        applyFilters();
      }
      function applyFilters() {
        const query = search.value.trim().toLowerCase();
        let shown = 0;
        for (const section of document.querySelectorAll(".adm-game")) {
          let rows = 0;
          for (const row of section.querySelectorAll("tbody tr")) {
            row.hidden = !!query && !row.dataset.name.includes(query);
            if (!row.hidden) rows += 1;
          }
          section.hidden = (!!gameFilter && section.dataset.game !== gameFilter) || rows === 0;
          if (!section.hidden) shown += 1;
        }
        $("#adm-search-empty").hidden = shown > 0;
      }
      for (const chip of chips) chip.addEventListener("click", () => filterGame(chip.dataset.gameFilter));
      search.addEventListener("input", applyFilters);

      $("#admin-export").addEventListener("click", () => {
        if (!snapshot) return;
        const quote = (value) => (/[",\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value);
        const lines = [["game", "mod", ...csvColumns].join(",")];
        for (const row of document.querySelectorAll("[data-admin-mod]")) {
          const key = row.dataset.adminMod;
          const values = modValues(key);
          const [game] = key.split("/");
          const fields = [gameNames[game] ?? game, names[key] ?? key, ...csvColumns.map((field) => values[field] ?? "")];
          lines.push(fields.map((value) => quote(String(value))).join(","));
        }
        const link = document.createElement("a");
        link.href = URL.createObjectURL(new Blob([lines.join("\n") + "\n"], { type: "text/csv" }));
        link.download = `azraels-mods-downloads-${new Date().toISOString().slice(0, 10)}.csv`;
        link.click();
        setTimeout(() => URL.revokeObjectURL(link.href), 1000);
      });

      // ---- API ----
      // The session is an HttpOnly cookie, so requests carry it on their own.
      async function call(path, method = "GET", payload) {
        const res = await fetch(path, {
          method,
          credentials: "same-origin",
          headers: payload === undefined ? {} : { "content-type": "application/json" },
          body: payload === undefined ? undefined : JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw Object.assign(new Error(data.error ?? `Request failed (${res.status}).`), { status: res.status });
        return data;
      }

      function cell(text, className) {
        const td = document.createElement("td");
        td.textContent = text;
        if (className) td.className = className;
        return td;
      }

      function timeCell(iso) {
        const td = cell(ago(iso));
        td.title = when(iso);
        return td;
      }

      function emptyRow(tbody, columns, text) {
        const row = document.createElement("tr");
        const td = cell(text, "adm-muted");
        td.colSpan = columns;
        row.append(td);
        tbody.replaceChildren(row);
      }

      // ---- Releases ----
      const stateLabels = {
        live: ["Live", "ok"],
        newer: ["New upload", "info"],
        "build-only": ["Not in downloads.json", "warn"],
        behind: ["downloads.json is older", "warn"],
        unknown: ["Manifest unreadable", "muted"],
        "not-ready": ["No public zip", "muted"],
      };
      const needsAttention = (mod) => stateLabels[mod.state]?.[1] === "warn";
      let releases = [];
      const releaseGame = $("#adm-release-game");
      const releaseStatus = $("#adm-release-status");
      releaseStatus.append(
        ...Object.entries(stateLabels).map(([value, [label]]) => {
          const option = document.createElement("option");
          option.value = value;
          option.textContent = label;
          return option;
        }),
      );
      function renderReleases() {
        const tbody = $("#adm-releases");
        const game = releaseGame.value;
        const status = releaseStatus.value;
        const list = releases.filter(
          (mod) =>
            (!game || mod.game === game) &&
            (!status || (status === "attention" ? needsAttention(mod) : mod.state === status)),
        );
        if (list.length === 0) {
          const message =
            releases.length === 0 ? "No mods." : status === "attention" && !game ? "Nothing needs attention." : "No releases match these filters.";
          return emptyRow(tbody, 6, message);
        }
        tbody.replaceChildren(
          ...list.map((mod) => {
            const row = document.createElement("tr");
            const name = document.createElement("th");
            name.scope = "row";
            const link = document.createElement("a");
            link.href = `/${mod.key}`;
            link.textContent = mod.name;
            name.append(link);
            const [label, tone] = stateLabels[mod.state] ?? [mod.state, "muted"];
            const pill = document.createElement("span");
            pill.className = `adm-pill is-${tone}`;
            pill.textContent = label;
            const state = document.createElement("td");
            state.append(pill);
            row.append(
              name,
              cell(gameNames[mod.game] ?? mod.game),
              cell(`v${mod.built.version}`),
              cell(mod.hosted ? `v${mod.hosted.version}` : "—"),
              timeCell(mod.hosted?.uploadedAt ?? mod.built.uploadedAt),
              state,
            );
            return row;
          }),
        );
      }
      async function loadReleases() {
        try {
          const data = await call("/api/admin/releases");
          releases = data.mods;
          const issues = releases.filter(needsAttention).length;
          const badge = $("#adm-release-badge");
          badge.textContent = String(issues);
          badge.hidden = issues === 0;
          setCheck("manifest", data.manifest, data.manifest ? "downloads.json is readable" : "downloads.json could not be read");
          if (data.manifest) setCheck("releases", issues === 0, issues === 0 ? "Every release is live" : `${issues} release${issues === 1 ? "" : "s"} need attention`);
          renderReleases();
        } catch (error) {
          loaded.delete("releases");
          if (error.status === 401) return showLogin(error.message);
          emptyRow($("#adm-releases"), 6, error.message);
        }
      }
      releaseGame.addEventListener("change", renderReleases);
      releaseStatus.addEventListener("change", renderReleases);

      // ---- Activity ----
      async function loadActivity() {
        const tbody = $("#adm-activity");
        try {
          const { rows } = await call("/api/admin/site-downloads");
          if (rows.length === 0) return emptyRow(tbody, 5, "No clicks yet.");
          tbody.replaceChildren(
            ...rows.slice(0, 100).map((entry) => {
              const row = document.createElement("tr");
              const [game] = entry.key.split("/");
              const name = document.createElement("th");
              name.scope = "row";
              name.textContent = names[entry.key] ?? entry.key;
              row.append(name, cell(gameNames[game] ?? game), cell(`v${entry.version}`), cell(format(entry.count), "is-num"), timeCell(entry.lastAt));
              return row;
            }),
          );
        } catch (error) {
          loaded.delete("activity");
          if (error.status === 401) return showLogin(error.message);
          emptyRow(tbody, 5, error.message);
        }
      }

      // ---- Supporters ----
      const donorStatus = $("#adm-donor-status");
      const providerNames = { kofi: "Ko-fi", manual: "By hand" };
      async function loadDonors() {
        const tbody = $("#adm-donors");
        try {
          const { donors, kofiToken } = await call("/api/admin/donors");
          $("#adm-kofi-missing").hidden = kofiToken;
          if (donors.length === 0) return emptyRow(tbody, 6, "No supporters yet.");
          tbody.replaceChildren(
            ...donors.map((donor) => {
              const row = document.createElement("tr");
              if (donor.hidden || !donor.isPublic) row.classList.add("is-dim");
              const name = document.createElement("th");
              name.scope = "row";
              name.textContent = donor.name;
              const tags = [];
              if (!donor.isPublic) tags.push(["Private", "is-muted"]);
              if (donor.hidden) tags.push(["Hidden", "is-warn"]);
              for (const [text, tone] of tags) {
                const pill = document.createElement("span");
                pill.className = `adm-pill ${tone}`;
                pill.textContent = text;
                name.append(" ", pill);
              }
              const kind = [providerNames[donor.provider] ?? donor.provider, donor.isSubscription ? `membership${donor.tier ? ` (${donor.tier})` : ""}` : donor.type.toLowerCase()].join(" · ");
              const amount = donor.amount ? `${donor.amount}${donor.currency ? ` ${donor.currency}` : ""}` : "—";
              const action = document.createElement("td");
              const toggle = document.createElement("button");
              toggle.type = "button";
              toggle.className = "adm-btn is-quiet";
              toggle.textContent = donor.hidden ? "Show" : "Hide";
              toggle.title = donor.hidden ? "Show on the Supporters page again" : "Keep off the Supporters page";
              toggle.addEventListener("click", () => donorAction("/api/admin/donors/hide", { id: donor.id, hidden: !donor.hidden }, donor.hidden ? "Shown again." : "Hidden from the page."));
              action.append(toggle);
              if (donor.provider === "manual") {
                const remove = document.createElement("button");
                remove.type = "button";
                remove.className = "adm-btn is-quiet";
                remove.textContent = "Delete";
                remove.addEventListener("click", () => {
                  if (confirm(`Delete ${donor.name}?`)) donorAction("/api/admin/donors/delete", { id: donor.id }, "Deleted.");
                });
                action.append(remove);
              }
              row.append(name, cell(donor.message ?? "—"), cell(kind), cell(amount, "is-num"), timeCell(donor.createdAt), action);
              return row;
            }),
          );
        } catch (error) {
          loaded.delete("supporters");
          if (error.status === 401) return showLogin(error.message);
          emptyRow(tbody, 6, error.message);
        }
      }
      async function donorAction(path, payload, done) {
        try {
          await call(path, "POST", payload);
          donorStatus.textContent = `${done} The public page catches up within five minutes.`;
          loadDonors();
        } catch (error) {
          if (error.status === 401) return showLogin(error.message);
          donorStatus.textContent = error.message;
        }
      }
      $("#adm-donor-add").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        const data = new FormData(form);
        const [amount, currency] = String(data.get("amount") ?? "").trim().split(/\s+/);
        await donorAction(
          "/api/admin/donors",
          {
            name: data.get("name"),
            message: data.get("message"),
            date: data.get("date") || undefined,
            amount: amount || undefined,
            currency: currency || undefined,
            isPublic: data.get("isPublic") === "on",
          },
          "Added.",
        );
        form.reset();
      });

      // ---- Requests ----
      const requestStatus = $("#adm-request-status");
      const requestStates = [["pending", "Waiting"], ["open", "Open"], ["planned", "Planned"], ["done", "Done"], ["declined", "Declined"]];
      async function loadRequests() {
        const tbody = $("#adm-requests");
        try {
          const { requests } = await call("/api/admin/requests");
          if (requests.length === 0) return emptyRow(tbody, 7, "No requests yet.");
          tbody.replaceChildren(
            ...requests.map((request) => {
              const row = document.createElement("tr");
              if (request.status === "declined") row.classList.add("is-dim");
              const title = document.createElement("th");
              title.scope = "row";
              title.textContent = request.title;
              if (request.status === "pending") {
                const pill = document.createElement("span");
                pill.className = "adm-pill is-warn";
                pill.textContent = "New";
                title.append(" ", pill);
              }
              if (request.details) {
                const details = document.createElement("p");
                details.className = "adm-muted adm-request-details";
                details.textContent = request.details;
                title.append(details);
              }
              const pick = document.createElement("select");
              pick.setAttribute("aria-label", `Status of ${request.title}`);
              for (const [value, label] of requestStates) pick.append(new Option(label, value, false, value === request.status));
              const note = document.createElement("input");
              note.type = "text";
              note.maxLength = 300;
              note.value = request.note ?? "";
              note.setAttribute("aria-label", `Note on ${request.title}`);
              const stateCell = document.createElement("td");
              stateCell.append(pick);
              const noteCell = document.createElement("td");
              noteCell.append(note);
              const action = document.createElement("td");
              const save = document.createElement("button");
              save.type = "button";
              save.className = "adm-btn is-quiet";
              save.textContent = "Save";
              save.addEventListener("click", () => requestAction("/api/admin/requests", { id: request.id, status: pick.value, note: note.value }, "Saved."));
              const remove = document.createElement("button");
              remove.type = "button";
              remove.className = "adm-btn is-quiet";
              remove.textContent = "Delete";
              remove.addEventListener("click", () => {
                if (confirm(`Delete "${request.title}"?`)) requestAction("/api/admin/requests/delete", { id: request.id }, "Deleted.");
              });
              action.append(save, remove);
              row.append(title, cell(gameNames[request.game] ?? "Other"), cell(format(request.votes), "is-num"), timeCell(request.createdAt), stateCell, noteCell, action);
              return row;
            }),
          );
        } catch (error) {
          loaded.delete("requests");
          if (error.status === 401) return showLogin(error.message);
          emptyRow(tbody, 7, error.message);
        }
      }
      async function requestAction(path, payload, done) {
        try {
          await call(path, "POST", payload);
          requestStatus.textContent = done;
          loadRequests();
        } catch (error) {
          if (error.status === 401) return showLogin(error.message);
          requestStatus.textContent = error.message;
        }
      }

      // ---- History ----
      let historyData = null;
      let historyDays = 30;
      const historyScope = $("#adm-history-scope");
      const shortDay = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
      const dayLabel = (day) => shortDay.format(new Date(`${day}T00:00:00Z`));
      const svgEl = (tag, attrs = {}) => {
        const el = document.createElementNS("http://www.w3.org/2000/svg", tag);
        for (const [name, value] of Object.entries(attrs)) el.setAttribute(name, String(value));
        return el;
      };
      function historyKeys() {
        const scope = historyScope.value;
        const keys = Object.keys(historyData?.mods ?? {});
        if (!scope) return keys;
        if (scope.startsWith("game:")) return keys.filter((key) => key.startsWith(`${scope.slice(5)}/`));
        return keys.filter((key) => key === scope);
      }
      // One value per day; a store day with no reading for any selected mod stays null.
      function seriesFor(field) {
        const keys = historyKeys();
        return historyData.days.map((_day, at) => {
          let total = null;
          for (const key of keys) {
            const value = historyData.mods[key][field][at];
            if (typeof value === "number") total = (total ?? 0) + value;
          }
          return field === "site" ? (total ?? 0) : total;
        });
      }
      // Four whole-number gridline steps: 1, 2 or 5 times a power of ten.
      function niceMax(value) {
        const raw = Math.max(1, value / 4);
        const mag = 10 ** Math.floor(Math.log10(raw));
        const step = [1, 2, 5, 10].map((mult) => mult * mag).find((candidate) => candidate >= raw);
        return Math.max(4, Math.ceil(step) * 4);
      }
      function drawChart(figure, values) {
        const plot = figure.querySelector("[data-chart-plot]");
        const known = values.filter((value) => typeof value === "number");
        const sum = known.reduce((total, value) => total + value, 0);
        figure.querySelector("[data-chart-total]").textContent = known.length
          ? `${format(sum)} in ${historyData.days.length} days`
          : "No readings yet";
        const width = 640;
        const height = 220;
        const pad = { top: 12, right: 8, bottom: 26, left: 40 };
        const innerW = width - pad.left - pad.right;
        const innerH = height - pad.top - pad.bottom;
        const max = niceMax(Math.max(0, ...known));
        const svg = svgEl("svg", { viewBox: `0 0 ${width} ${height}`, role: "img", "aria-label": `${figure.querySelector("h2").textContent}: ${format(sum)} total` });
        for (let tick = 0; tick <= 4; tick += 1) {
          const value = (max / 4) * tick;
          const y = pad.top + innerH - (value / max) * innerH;
          svg.append(svgEl("line", { x1: pad.left, x2: width - pad.right, y1: y, y2: y, class: tick === 0 ? "adm-axis" : "adm-grid" }));
          const label = svgEl("text", { x: pad.left - 6, y: y + 4, "text-anchor": "end", class: "adm-tick" });
          label.textContent = format(Math.round(value));
          svg.append(label);
        }
        const slot = innerW / values.length;
        const barW = Math.max(2, Math.min(18, slot - 2));
        const labelEvery = Math.ceil(values.length / 6);
        values.forEach((value, at) => {
          const x = pad.left + at * slot + (slot - barW) / 2;
          const group = svgEl("g", { class: "adm-bar" });
          // A full-height hit area makes small bars easy to hover.
          group.append(svgEl("rect", { x: pad.left + at * slot, y: pad.top, width: slot, height: innerH, class: "adm-hit" }));
          if (typeof value === "number" && value > 0) {
            const h = Math.max(1, (value / max) * innerH);
            const r = Math.min(4, barW / 2, h);
            const top = pad.top + innerH - h;
            // Rounded top, square base on the axis.
            group.append(
              svgEl("path", {
                d: `M${x},${pad.top + innerH}V${top + r}Q${x},${top} ${x + r},${top}H${x + barW - r}Q${x + barW},${top} ${x + barW},${top + r}V${pad.top + innerH}Z`,
                class: "adm-bar-fill",
              }),
            );
          }
          const tip = svgEl("title");
          tip.textContent = `${dayLabel(historyData.days[at])}: ${typeof value === "number" ? format(value) : "no reading"}`;
          group.append(tip);
          svg.append(group);
          if (at % labelEvery === 0 || at === values.length - 1) {
            const label = svgEl("text", { x: pad.left + at * slot + slot / 2, y: height - 8, "text-anchor": "middle", class: "adm-tick" });
            label.textContent = dayLabel(historyData.days[at]);
            svg.append(label);
          }
        });
        plot.replaceChildren(svg);
      }
      function renderHistory() {
        if (!historyData) return;
        const site = seriesFor("site");
        const store = seriesFor("store");
        drawChart($('[data-chart="site"]'), site);
        drawChart($('[data-chart="store"]'), store);
        const tbody = $("#adm-history-rows");
        tbody.replaceChildren(
          ...historyData.days
            .map((day, at) => {
              const row = document.createElement("tr");
              const th = document.createElement("th");
              th.scope = "row";
              th.className = "is-left";
              th.textContent = dayLabel(day);
              row.append(th, cell(format(site[at]), "is-num"), cell(typeof store[at] === "number" ? format(store[at]) : "—", "is-num"));
              return row;
            })
            .reverse(),
        );
      }
      async function loadHistory() {
        try {
          historyData = await call(`/api/admin/history?days=${historyDays}`);
          renderHistory();
        } catch (error) {
          loaded.delete("history");
          if (error.status === 401) return showLogin(error.message);
          emptyRow($("#adm-history-rows"), 3, error.message);
          for (const plot of document.querySelectorAll("[data-chart-plot]")) plot.textContent = error.message;
        }
      }
      historyScope.addEventListener("change", renderHistory);
      for (const button of document.querySelectorAll("[data-history-days]")) {
        button.addEventListener("click", () => {
          historyDays = Number(button.dataset.historyDays);
          for (const other of document.querySelectorAll("[data-history-days]")) {
            const on = other === button;
            other.classList.toggle("is-on", on);
            other.setAttribute("aria-pressed", String(on));
          }
          loadHistory();
        });
      }

      // ---- Health ----
      const checks = new Map();
      function setCheck(id, ok, text) {
        checks.set(id, { ok, text });
        $("#adm-checks").replaceChildren(
          ...[...checks.values()].map((check) => {
            const item = document.createElement("li");
            const dot = document.createElement("span");
            dot.className = `adm-dot${check.ok === true ? " is-ok" : check.ok === false ? " is-bad" : ""}`;
            item.append(dot, document.createTextNode(check.text));
            return item;
          }),
        );
      }
      async function loadOverview() {
        try {
          const data = await call("/api/admin/overview");
          setCheck("db", data.database, data.database ? "D1 database connected" : "No D1 database: no site counts or passkeys");
          setCheck("nexus", data.nexusKey, data.nexusKey ? "Nexus API key set" : "No Nexus API key: Nexus counts are frozen");
          setCheck("password", data.password ? null : true, data.password ? "Password sign-in is on (ADMIN_TOKEN set)" : "Password sign-in is off");
          $("#adm-sessions").textContent = format(data.sessions);
          $("#adm-sessions-label").textContent = data.sessions === 1 ? "active session" : "active sessions";
          renderToolReleases(data.tools);
        } catch (error) {
          if (error.status === 401) return showLogin(error.message);
          setCheck("overview", false, error.message);
        }
      }

      // ---- Passkeys ----
      // WebAuthn wants ArrayBuffers; the server speaks base64url JSON.
      const toBytes = (value) =>
        Uint8Array.from(atob(value.replace(/-/g, "+").replace(/_/g, "/")), (char) => char.charCodeAt(0));
      const toText = (buffer) =>
        buffer
          ? btoa(String.fromCharCode(...new Uint8Array(buffer)))
              .replace(/\+/g, "-")
              .replace(/\//g, "_")
              .replace(/=+$/, "")
          : undefined;
      const withIds = (list) => (list ?? []).map((entry) => ({ ...entry, id: toBytes(entry.id) }));

      function credentialJson(credential) {
        const { response } = credential;
        const json = {
          id: credential.id,
          rawId: toText(credential.rawId),
          type: credential.type,
          clientExtensionResults: credential.getClientExtensionResults?.() ?? {},
          authenticatorAttachment: credential.authenticatorAttachment ?? undefined,
          response: { clientDataJSON: toText(response.clientDataJSON) },
        };
        if (response.attestationObject) {
          json.response.attestationObject = toText(response.attestationObject);
          json.response.transports = response.getTransports?.() ?? [];
        } else {
          json.response.authenticatorData = toText(response.authenticatorData);
          json.response.signature = toText(response.signature);
          json.response.userHandle = toText(response.userHandle);
        }
        return json;
      }

      function passkeyError(error) {
        if (error?.name === "NotAllowedError") return "The passkey prompt was closed or timed out.";
        if (error?.name === "InvalidStateError") return "That passkey is already added.";
        return error?.message ?? "Something went wrong.";
      }

      function renderPasskeys(passkeys) {
        setCheck("passkeys", passkeys.length > 0 ? true : null, `${passkeys.length} passkey${passkeys.length === 1 ? "" : "s"} registered`);
        passkeyList.replaceChildren(
          ...passkeys.map((passkey) => {
            const item = document.createElement("li");
            const text = document.createElement("div");
            const name = document.createElement("strong");
            name.textContent = passkey.name;
            const meta = document.createElement("span");
            meta.textContent = `Added ${when(passkey.createdAt)} · last used ${passkey.lastUsedAt ? ago(passkey.lastUsedAt) : "never"}`;
            text.append(name, meta);
            const remove = document.createElement("button");
            remove.type = "button";
            remove.className = "adm-btn is-quiet";
            remove.textContent = "Remove";
            remove.addEventListener("click", async () => {
              if (!confirm(`Remove the passkey "${passkey.name}"?`)) return;
              try {
                await call(`/api/admin/passkeys/${encodeURIComponent(passkey.id)}`, "DELETE");
                passkeyStatus.textContent = "Passkey removed.";
                loadPasskeys();
              } catch (error) {
                passkeyStatus.textContent = error.message;
              }
            });
            item.append(text, remove);
            return item;
          }),
        );
        if (passkeys.length === 0) {
          const item = document.createElement("li");
          item.className = "adm-muted";
          item.textContent = "No passkeys yet.";
          passkeyList.append(item);
        }
      }

      async function loadPasskeys() {
        try {
          renderPasskeys((await call("/api/admin/passkeys")).passkeys);
        } catch (error) {
          passkeyStatus.textContent = error.message;
        }
      }

      // ---- Sessions ----
      // A short "Chrome on Windows" from the user agent; the full string is in the tooltip.
      function deviceName(agent) {
        if (!agent) return "Unknown device";
        const browser = /Edg\//.test(agent)
          ? "Edge"
          : /OPR\//.test(agent)
            ? "Opera"
            : /Firefox\//.test(agent)
              ? "Firefox"
              : /Chrome\//.test(agent)
                ? "Chrome"
                : /Safari\//.test(agent)
                  ? "Safari"
                  : /curl|wget|python|node/i.test(agent)
                    ? "Script"
                    : "Browser";
        const os = /iPhone|iPad/.test(agent)
          ? "iOS"
          : /Android/.test(agent)
            ? "Android"
            : /Windows/.test(agent)
              ? "Windows"
              : /Mac OS X|Macintosh/.test(agent)
                ? "macOS"
                : /CrOS/.test(agent)
                  ? "ChromeOS"
                  : /Linux/.test(agent)
                    ? "Linux"
                    : "";
        return os ? `${browser} on ${os}` : browser;
      }
      const sessionStatus = $("#adm-session-status");
      function renderSessions(sessions) {
        const tbody = $("#adm-session-rows");
        $("#adm-sessions").textContent = format(sessions.length);
        $("#adm-sessions-label").textContent = sessions.length === 1 ? "active session" : "active sessions";
        if (sessions.length === 0) return emptyRow(tbody, 6, "No active sessions.");
        tbody.replaceChildren(
          ...sessions.map((session) => {
            const row = document.createElement("tr");
            const device = document.createElement("th");
            device.scope = "row";
            const name = document.createElement("div");
            name.className = "adm-session-device";
            const title = document.createElement("strong");
            title.textContent = deviceName(session.userAgent);
            title.title = session.userAgent ?? "";
            if (session.current) {
              const pill = document.createElement("span");
              pill.className = "adm-pill is-ok";
              pill.textContent = "This browser";
              title.append(pill);
            }
            const where = document.createElement("span");
            where.textContent = session.country ? `From ${session.country}` : "Location not recorded";
            name.append(title, where);
            device.append(name);
            const method = session.method === "passkey" ? `Passkey${session.label ? ` (${session.label})` : ""}` : "Password";
            const action = document.createElement("td");
            const end = document.createElement("button");
            end.type = "button";
            end.className = "adm-btn is-quiet";
            end.textContent = "Sign out";
            end.addEventListener("click", async () => {
              const prompt = session.current ? "Sign out this browser?" : `Sign out ${deviceName(session.userAgent)}?`;
              if (!confirm(prompt)) return;
              try {
                const result = await call(`/api/admin/sessions/${session.id}`, "DELETE");
                if (!result.signedIn) return showLogin("Signed out.");
                sessionStatus.textContent = "Session signed out.";
                loadSessions();
              } catch (error) {
                if (error.status === 401) return showLogin(error.message);
                sessionStatus.textContent = error.message;
                loadSessions();
              }
            });
            action.append(end);
            row.append(
              device,
              cell(method),
              session.createdAt ? timeCell(session.createdAt) : cell("—"),
              session.lastSeenAt ? timeCell(session.lastSeenAt) : cell("—"),
              timeCell(session.expiresAt),
              action,
            );
            return row;
          }),
        );
      }
      async function loadSessions() {
        try {
          renderSessions((await call("/api/admin/sessions")).sessions);
        } catch (error) {
          if (error.status === 401) return showLogin(error.message);
          emptyRow($("#adm-session-rows"), 6, error.message);
        }
      }

      // ---- Sign-in ----
      async function showLogin(message = "") {
        body.hidden = true;
        login.hidden = false;
        loaded.clear();
        loginError.textContent = message;
        const state = await call("/api/admin/session").catch((error) => ({ error: error.message }));
        if (state.signedIn) return openAdmin();
        passkeyLogin.hidden = !(passkeysSupported && state.passkeys);
        passwordLogin.hidden = !state.password;
        loginOr.hidden = passkeyLogin.hidden || passwordLogin.hidden;
        if (state.error && !message) loginError.textContent = state.error;
        else if (!state.passkeys && !state.password && !message) loginError.textContent = "No sign-in method is set up.";
      }

      async function openAdmin() {
        try {
          const next = await call("/api/admin/stats");
          login.hidden = true;
          body.hidden = false;
          loginError.textContent = "";
          greet();
          render(next);
          loadPasskeys();
          loadOverview();
          loadSessions();
          // Releases feed the tab badge and the health list, so they load straight away.
          loadTab("releases");
          showTab(location.hash.slice(1) || "overview", false);
        } catch (error) {
          if (error.status === 401) return showLogin();
          showLogin(error.message);
        }
      }

      passwordLogin.addEventListener("submit", async (event) => {
        event.preventDefault();
        const password = String(new FormData(passwordLogin).get("password") ?? "");
        if (!password) return;
        loginError.textContent = "";
        try {
          await call("/api/admin/login", "POST", { password });
          passwordLogin.reset();
          openAdmin();
        } catch (error) {
          loginError.textContent = error.message;
        }
      });

      passkeyLogin.addEventListener("click", async () => {
        loginError.textContent = "";
        passkeyLogin.disabled = true;
        try {
          const options = await call("/api/admin/passkey/login-options", "POST", {});
          const credential = await navigator.credentials.get({
            publicKey: { ...options, challenge: toBytes(options.challenge), allowCredentials: withIds(options.allowCredentials) },
          });
          await call("/api/admin/passkey/login", "POST", { response: credentialJson(credential) });
          openAdmin();
        } catch (error) {
          loginError.textContent = passkeyError(error);
        } finally {
          passkeyLogin.disabled = false;
        }
      });

      passkeyAdd.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!passkeysSupported) {
          passkeyStatus.textContent = "This browser does not support passkeys.";
          return;
        }
        const name = String(new FormData(passkeyAdd).get("name") ?? "");
        passkeyStatus.textContent = "Follow your password manager's prompt…";
        try {
          const options = await call("/api/admin/passkey/register-options", "POST", {});
          const credential = await navigator.credentials.create({
            publicKey: {
              ...options,
              challenge: toBytes(options.challenge),
              user: { ...options.user, id: toBytes(options.user.id) },
              excludeCredentials: withIds(options.excludeCredentials),
            },
          });
          await call("/api/admin/passkey/register", "POST", { response: credentialJson(credential), name });
          passkeyAdd.reset();
          passkeyStatus.textContent = "Passkey added. Sign out and back in to try it.";
          loadPasskeys();
        } catch (error) {
          if (error.status === 401) return showLogin(error.message);
          passkeyStatus.textContent = passkeyError(error);
        }
      });

      refreshButton.addEventListener("click", async () => {
        refreshButton.disabled = true;
        status.textContent = "Fetching Steam, Thunderstore, and Nexus…";
        try {
          render(await call("/api/admin/refresh", "POST", {}));
          status.textContent = "Refreshed. Public pages can take up to five minutes to show the new numbers.";
          loaded.delete("activity");
          if (!$("#panel-activity").hidden) loadTab("activity");
        } catch (error) {
          if (error.status === 401) return showLogin(error.message);
          status.textContent = error.message;
        } finally {
          refreshButton.disabled = false;
        }
      });

      $("#admin-logout").addEventListener("click", async () => {
        await call("/api/admin/logout", "POST", {}).catch(() => {});
        showLogin();
      });

      $("#adm-signout-all").addEventListener("click", async () => {
        if (!confirm("Sign out every browser, including this one?")) return;
        try {
          await call("/api/admin/sessions/clear", "POST", {});
          showLogin("Signed out everywhere.");
        } catch (error) {
          passkeyStatus.textContent = error.message;
        }
      });

      // Keeps the "ago" times honest while the page sits open.
      setInterval(() => {
        if (!body.hidden && snapshot) stampTimes();
      }, 30_000);

      // The old page kept the password in sessionStorage; clear it.
      try {
        sessionStorage.removeItem("azraels-admin-password");
      } catch {}
      openAdmin();
    })();
  </script>
</Base>
