---
import Base from "../../layouts/Base.astro";
import ReportForm from "../../components/ReportForm.astro";
import StoreCounts from "../../components/StoreCounts.astro";
import { games } from "../../data/games";
import { hubInfo } from "../../data/hub-index";
import { isNotReady, mods, modsForGame, r2Download, uploadedOn, type ModEntry } from "../../data/mods";
import { statRows } from "../../data/stats";
import { commandsFor } from "../../data/sevendays-commands";
import { indexInfo, installHints, installLabels } from "../../data/sevendays-index";
import { heroVars, lookFor } from "../../data/themes";

export function getStaticPaths() {
  return mods.map((mod) => ({
    params: { slug: mod.game, mod: mod.slug },
    props: { mod },
  }));
}

interface Props {
  mod: ModEntry;
}

const { mod } = Astro.props;
const game = games.find((entry) => entry.slug === mod.game);
const look = lookFor(mod.slug);
// Azrael's preview file is the Homesteader poster, so this page does not show it again.
const preview = mod.slug === "azrael" ? undefined : mod.images[0];
// Only the plain fallback layout lists the other mods; the game pages link back to the full list.
const others = modsForGame(mod.game).filter((entry) => entry.slug !== mod.slug);
const direct = r2Download(mod);
const updated = uploadedOn(mod);
const notReady = isNotReady(mod);
const latestKey = notReady ? undefined : `${mod.game}/${mod.slug}`;
const sevendays = mod.game === "7-days-to-die";
const sevenInfo = sevendays ? indexInfo(mod) : undefined;
const info = sevenInfo ?? hubInfo(mod);
// The Downloads row on 7 Days to Die pages is Nexus; the other games list each store.
const countRows = sevendays ? [] : statRows(mod.game, true);
const commands = sevendays ? commandsFor(mod.slug) : undefined;
const guide = mod.guide;
const overview = guide?.overview?.length ? guide.overview : [mod.description];
const sections = guide?.sections ?? [];
const storeLinks = [
  ["Steam", mod.links.steam],
  ["Thunderstore", mod.links.thunderstore],
  ["Nexus", mod.links.nexus],
].filter((entry): entry is [string, string] => Boolean(entry[1]));
---

<Base title={mod.name} description={mod.description} game={mod.game}>
  {
    mod.game === "rimworld" || mod.game === "sun-haven" || mod.game === "7-days-to-die" ? (
      <div
        class:list={[
          mod.game === "rimworld" ? "rw-hub rw-mod" : mod.game === "sun-haven" ? "sh-hub sh-mod" : "zd-hub zd-mod",
          "guide-page",
        ]}
        style={heroVars(mod.slug)}
      >
        <header class="rw-hero">
          <div class="rw-wrap rw-hero-layout">
            <div>
              <p class="rw-kicker">
                <a href={`/${mod.game}`}>← All {game?.name} mods</a>
              </p>
              <h1>{mod.name}</h1>
              <p class="rw-tagline">{look.mark}</p>
              {
                guide?.badges?.length ? (
                  <p class="rw-pills">
                    {guide.badges.map((badge) => (
                      <span>{badge}</span>
                    ))}
                  </p>
                ) : null
              }
              {overview.map((paragraph) => (
                <p class="rw-intro">{paragraph}</p>
              ))}
            </div>
            <aside class="rw-stats zd-details" aria-labelledby="mod-details" data-stat-scope="mod" data-stat-key={`${mod.game}/${mod.slug}`}>
              <h2 class="rw-stat-label" id="mod-details">Details</h2>
              <p class="zd-details-summary">{info.short}</p>
              <dl>
                <div>
                  <dt>Type</dt>
                  <dd>{info.category}</dd>
                </div>
                {sevenInfo && (
                  <div>
                    <dt>Installs on</dt>
                    <dd>
                      <span class:list={["zd-side", `is-${sevenInfo.installs}`]}>{installLabels[sevenInfo.installs]}</span>
                      <small>{installHints[sevenInfo.installs]}</small>
                    </dd>
                  </div>
                )}
                <div>
                  <dt>Version</dt>
                  <dd>v<span data-latest={latestKey} data-latest-field="version">{mod.version}</span></dd>
                </div>
                <div>
                  <dt>Updated</dt>
                  <dd>
                    {updated ? (
                      <time datetime={updated.iso} data-latest={latestKey} data-latest-field="uploadedAt">{updated.label}</time>
                    ) : (
                      "—"
                    )}
                  </dd>
                </div>
                {sevendays ? (
                  <div>
                    <dt>Downloads</dt>
                    <dd data-field="nexus_full">—</dd>
                  </div>
                ) : (
                  countRows.map((row) => (
                    <div>
                      <dt>{row.label}</dt>
                      <dd data-field={row.field}>—</dd>
                    </div>
                  ))
                )}
                {direct && (
                  <div>
                    <dt>File</dt>
                    <dd data-latest={latestKey} data-latest-field="file">{direct.file}</dd>
                  </div>
                )}
              </dl>
            </aside>
          </div>
        </header>
        <div class="rw-wrap">
          {
            preview && (
              <figure class="rw-poster">
                <img src={preview} alt={`${mod.name} preview`} width="960" />
              </figure>
            )
          }
          <p class="rw-actions">
            {
              direct && (
                <a class="download" href={direct.url}>
                  Download <span data-latest={latestKey} data-latest-field="file">{direct.file}</span>
                </a>
              )
            }
            {
              notReady && (
                <a class="download" href="/not-ready">
                  Download
                </a>
              )
            }
            {storeLinks.map(([label, href]) => (
              <a href={href}>{label}</a>
            ))}
          </p>
          {
            sections.length > 0 && (
              <section class="rw-section" data-feature-tabs>
                <h2>What it does</h2>
                {
                  sections.length > 1 && (
                    <div class="rw-tabs" role="tablist" aria-label={`${mod.name} topics`}>
                      {sections.map((section, index) => (
                        <button type="button" role="tab" data-tab={section.id} aria-selected={index === 0 ? "true" : "false"}>
                          {section.label}
                        </button>
                      ))}
                    </div>
                  )
                }
                {sections.map((section, index) => (
                  <div class="rw-features" role="tabpanel" data-panel={section.id} hidden={index === 0 ? undefined : true}>
                    {section.features.map((feature) => (
                      <article class="rw-feature">
                        <h3>
                          {feature.title}
                          {feature.tag && <span class="rw-feature-tag">{feature.tag}</span>}
                        </h3>
                        <p>{feature.body}</p>
                      </article>
                    ))}
                  </div>
                ))}
              </section>
            )
          }
          {
            commands && (
              <section class="rw-section zd-commands">
                <h2>Commands</h2>
                {commands.intro && <p class="rw-intro">{commands.intro}</p>}
                {commands.groups.map((group) => (
                  <div class="zd-command-group">
                    <h3>
                      {group.title}
                      {group.aliases && <span class="rw-feature-tag">Also: {group.aliases}</span>}
                    </h3>
                    {group.note && <p class="rw-intro">{group.note}</p>}
                    <dl>
                      {group.rows.map((row) => (
                        <div>
                          <dt>
                            <code>
                              {row.cmd.split("|").map((part, index) => (
                                <>
                                  {index > 0 && <>|<wbr /></>}
                                  {part}
                                </>
                              ))}
                            </code>
                          </dt>
                          <dd>
                            {row.does}
                            {row.admin && <span class="rw-feature-tag">Admin</span>}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                ))}
              </section>
            )
          }
          {
            guide?.notes?.length ? (
              <section class="rw-section">
                <h2>Good to know</h2>
                <ul class="rw-notes">
                  {guide.notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>
              </section>
            ) : null
          }
          {
            guide?.faq && (
              <section class="rw-section">
                <h2>{guide.faq.title}</h2>
                {guide.faq.intro && <p class="rw-intro">{guide.faq.intro}</p>}
                <div class="rw-faq">
                  {guide.faq.rows.map((row) => (
                    <article>
                      <h3>{row.pair}</h3>
                      <p>{row.answer}</p>
                    </article>
                  ))}
                </div>
              </section>
            )
          }
          {
            (guide?.worksWith?.length || guide?.avoid?.length || guide?.compatNotes?.length) ? (
              <section class="rw-section">
                <h2>Alongside other mods</h2>
                <div class="rw-compat">
                  {
                    guide.worksWith?.length ? (
                      <div>
                        <h3>Works with</h3>
                        <ul class="rw-notes">
                          {guide.worksWith.map((entry) => (
                            <li>
                              <strong>{entry.name}</strong>
                              {entry.note ? ` — ${entry.note}` : ""}
                            </li>
                          ))}
                        </ul>
                      </div>
                    ) : null
                  }
                  {
                    guide.avoid?.length ? (
                      <div>
                        <h3>Leave these off</h3>
                        <ul class="rw-notes">
                          {guide.avoid.map((entry) => (
                            <li>
                              <strong>{entry.name}</strong>
                              {entry.note ? ` — ${entry.note}` : ""}
                            </li>
                          ))}
                        </ul>
                      </div>
                    ) : null
                  }
                </div>
                {guide.compatNotes?.map((note) => (
                  <p class="rw-intro">{note}</p>
                ))}
              </section>
            ) : null
          }
          <p class="zd-back">
            <a href={`/${mod.game}`}>← Back to all {game?.name} mods</a>
          </p>
          <ReportForm game={mod.game} mod={mod.slug} name={mod.name} gameName={game?.name ?? ""} />
        </div>
        <script is:inline>
          const root = document.querySelector("[data-feature-tabs]");
          if (root) {
            const tabs = [...root.querySelectorAll("[data-tab]")];
            const panels = [...root.querySelectorAll("[data-panel]")];
            const show = (id) => {
              for (const tab of tabs) tab.setAttribute("aria-selected", tab.dataset.tab === id ? "true" : "false");
              for (const panel of panels) panel.hidden = panel.dataset.panel !== id;
            };
            for (const tab of tabs) tab.addEventListener("click", () => show(tab.dataset.tab));
          }
        </script>
      </div>
    ) : (
  <article style={heroVars(mod.slug)}>
    <header class="hero">
      <p>
        <a href={`/${mod.game}`}>{game?.name}</a>
      </p>
      <h1>{mod.name}</h1>
      <p class="mark">{look.mark}</p>
      <p class="version">
        Version <span data-latest={latestKey} data-latest-field="version">{mod.version}</span>
        {updated && (
          <>
            {" "}· Updated <time datetime={updated.iso} data-latest={latestKey} data-latest-field="uploadedAt">{updated.label}</time>
          </>
        )}
      </p>
      <StoreCounts game={mod.game} mod={mod.slug} variant="page" />
      {
        preview && (
          <img src={preview} alt={`${mod.name} preview`} width="960" />
        )
      }
    </header>
    <p class="lede">{mod.description}</p>
    <p class="actions">
      {
        direct && (
          <a class="download" href={direct.url}>
            Download <span data-latest={latestKey} data-latest-field="file">{direct.file}</span>
          </a>
        )
      }
      {
        notReady && (
          <a class="download" href="/not-ready">
            Download
          </a>
        )
      }
      {storeLinks.map(([label, href]) => (
        <a href={href}>{label}</a>
      ))}
    </p>
    {
      others.length > 0 && (
        <nav class="others" aria-label={`Other ${game?.name ?? "game"} mods`}>
          <h2>Other {game?.name} mods</h2>
          <div class="chips">
            {others.map((entry) => (
              <a class="mod-chip" style={heroVars(entry.slug)} href={`/${entry.game}/${entry.slug}`}>
                <span class="mark">{lookFor(entry.slug).mark}</span>
                <strong>{entry.name}</strong>
              </a>
            ))}
          </div>
        </nav>
      )
    }
    <ReportForm game={mod.game} mod={mod.slug} name={mod.name} gameName={game?.name ?? ""} />
  </article>
    )
  }
</Base>
