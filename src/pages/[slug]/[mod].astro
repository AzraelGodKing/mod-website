---
import Base from "../../layouts/Base.astro";
import ReportForm from "../../components/ReportForm.astro";
import StoreCounts from "../../components/StoreCounts.astro";
import { games } from "../../data/games";
import { isNotReady, mods, modsForGame, r2Download, type ModEntry } from "../../data/mods";
import { heroVars, lookFor } from "../../data/themes";

export function getStaticPaths() {
  return mods.map((mod) => ({
    params: { slug: mod.game, mod: mod.slug },
    props: { mod },
  }));
}

interface Props {
  mod: ModEntry;
}

const { mod } = Astro.props;
const game = games.find((entry) => entry.slug === mod.game);
const look = lookFor(mod.slug);
// Azrael's preview file is the Homesteader poster, so this page does not show it again.
const preview = mod.slug === "azrael" ? undefined : mod.images[0];
const others = modsForGame(mod.game).filter((entry) => entry.slug !== mod.slug);
const direct = r2Download(mod);
const notReady = isNotReady(mod);
const guide = mod.guide;
const overview = guide?.overview?.length ? guide.overview : [mod.description];
const sections = guide?.sections ?? [];
const storeLinks = [
  ["Steam", mod.links.steam],
  ["Thunderstore", mod.links.thunderstore],
  ["Nexus", mod.links.nexus],
].filter((entry): entry is [string, string] => Boolean(entry[1]));
---

<Base title={mod.name} description={mod.description} game={mod.game}>
  {
    mod.game === "rimworld" || mod.game === "sun-haven" || mod.game === "7-days-to-die" ? (
      <div
        class:list={[
          mod.game === "rimworld" ? "rw-hub rw-mod" : mod.game === "sun-haven" ? "sh-hub sh-mod" : "zd-hub zd-mod",
          "guide-page",
        ]}
        style={heroVars(mod.slug)}
      >
        <header class="rw-hero">
          <div class="rw-wrap rw-hero-layout">
            <div>
              <p class="rw-kicker">
                <a href={`/${mod.game}`}>{game?.name}</a>
              </p>
              <h1>{mod.name}</h1>
              <p class="rw-tagline">{look.mark}</p>
              {
                guide?.badges?.length ? (
                  <p class="rw-pills">
                    {guide.badges.map((badge) => (
                      <span>{badge}</span>
                    ))}
                  </p>
                ) : null
              }
              {overview.map((paragraph) => (
                <p class="rw-intro">{paragraph}</p>
              ))}
            </div>
            <aside class="rw-stats">
              <span class="rw-stat-label">Version</span>
              <span class="rw-stat-num">{mod.version}</span>
              <StoreCounts game={mod.game} mod={mod.slug} variant="page" />
            </aside>
          </div>
        </header>
        <div class="rw-wrap">
          {
            preview && (
              <figure class="rw-poster">
                <img src={preview} alt={`${mod.name} preview`} width="960" />
              </figure>
            )
          }
          <p class="rw-actions">
            {
              direct && (
                <a class="download" href={direct.url}>
                  Download {direct.file}
                </a>
              )
            }
            {
              notReady && (
                <a class="download" href="/not-ready">
                  Download
                </a>
              )
            }
            {storeLinks.map(([label, href]) => (
              <a href={href}>{label}</a>
            ))}
          </p>
          {
            sections.length > 0 && (
              <section class="rw-section" data-feature-tabs>
                <h2>What it does</h2>
                {
                  sections.length > 1 && (
                    <div class="rw-tabs" role="tablist" aria-label={`${mod.name} topics`}>
                      {sections.map((section, index) => (
                        <button type="button" role="tab" data-tab={section.id} aria-selected={index === 0 ? "true" : "false"}>
                          {section.label}
                        </button>
                      ))}
                    </div>
                  )
                }
                {sections.map((section, index) => (
                  <div class="rw-features" role="tabpanel" data-panel={section.id} hidden={index === 0 ? undefined : true}>
                    {section.features.map((feature) => (
                      <article class="rw-feature">
                        <h3>
                          {feature.title}
                          {feature.tag && <span class="rw-feature-tag">{feature.tag}</span>}
                        </h3>
                        <p>{feature.body}</p>
                      </article>
                    ))}
                  </div>
                ))}
              </section>
            )
          }
          {
            guide?.notes?.length ? (
              <section class="rw-section">
                <h2>Good to know</h2>
                <ul class="rw-notes">
                  {guide.notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>
              </section>
            ) : null
          }
          {
            guide?.faq && (
              <section class="rw-section">
                <h2>{guide.faq.title}</h2>
                {guide.faq.intro && <p class="rw-intro">{guide.faq.intro}</p>}
                <div class="rw-faq">
                  {guide.faq.rows.map((row) => (
                    <article>
                      <h3>{row.pair}</h3>
                      <p>{row.answer}</p>
                    </article>
                  ))}
                </div>
              </section>
            )
          }
          {
            (guide?.worksWith?.length || guide?.avoid?.length || guide?.compatNotes?.length) ? (
              <section class="rw-section">
                <h2>Alongside other mods</h2>
                <div class="rw-compat">
                  {
                    guide.worksWith?.length ? (
                      <div>
                        <h3>Works with</h3>
                        <ul class="rw-notes">
                          {guide.worksWith.map((entry) => (
                            <li>
                              <strong>{entry.name}</strong>
                              {entry.note ? ` — ${entry.note}` : ""}
                            </li>
                          ))}
                        </ul>
                      </div>
                    ) : null
                  }
                  {
                    guide.avoid?.length ? (
                      <div>
                        <h3>Leave these off</h3>
                        <ul class="rw-notes">
                          {guide.avoid.map((entry) => (
                            <li>
                              <strong>{entry.name}</strong>
                              {entry.note ? ` — ${entry.note}` : ""}
                            </li>
                          ))}
                        </ul>
                      </div>
                    ) : null
                  }
                </div>
                {guide.compatNotes?.map((note) => (
                  <p class="rw-intro">{note}</p>
                ))}
              </section>
            ) : null
          }
          {
            others.length > 0 && (
              <nav class="rw-more" aria-label={`Other ${game?.name ?? "game"} mods`}>
                <h2>Other {game?.name} mods</h2>
                <div class="rw-grid">
                  {others.map((entry) => {
                    const entryLook = lookFor(entry.slug);
                    const entryPreview = entry.slug === "azrael" ? undefined : entry.images[0];
                    return (
                      <a class="rw-card" style={heroVars(entry.slug)} href={`/${entry.game}/${entry.slug}`}>
                        <span class="rw-media">
                          {entryPreview ? <img src={entryPreview} alt="" /> : <span class="rw-plate">{entryLook.mark}</span>}
                        </span>
                        <span class="rw-copy">
                          <h2>{entry.name}</h2>
                          <p>{entry.description}</p>
                          <span class="rw-badges">
                            <span>Version {entry.version}</span>
                            <span>{entryLook.mark}</span>
                          </span>
                        </span>
                      </a>
                    );
                  })}
                </div>
              </nav>
            )
          }
          <ReportForm game={mod.game} mod={mod.slug} name={mod.name} gameName={game?.name ?? ""} />
        </div>
        <script is:inline>
          const root = document.querySelector("[data-feature-tabs]");
          if (root) {
            const tabs = [...root.querySelectorAll("[data-tab]")];
            const panels = [...root.querySelectorAll("[data-panel]")];
            const show = (id) => {
              for (const tab of tabs) tab.setAttribute("aria-selected", tab.dataset.tab === id ? "true" : "false");
              for (const panel of panels) panel.hidden = panel.dataset.panel !== id;
            };
            for (const tab of tabs) tab.addEventListener("click", () => show(tab.dataset.tab));
          }
        </script>
      </div>
    ) : (
  <article style={heroVars(mod.slug)}>
    <header class="hero">
      <p>
        <a href={`/${mod.game}`}>{game?.name}</a>
      </p>
      <h1>{mod.name}</h1>
      <p class="mark">{look.mark}</p>
      <p class="version">Version {mod.version}</p>
      <StoreCounts game={mod.game} mod={mod.slug} variant="page" />
      {
        preview && (
          <img src={preview} alt={`${mod.name} preview`} width="960" />
        )
      }
    </header>
    <p class="lede">{mod.description}</p>
    <p class="actions">
      {
        direct && (
          <a class="download" href={direct.url}>
            Download {direct.file}
          </a>
        )
      }
      {
        notReady && (
          <a class="download" href="/not-ready">
            Download
          </a>
        )
      }
      {storeLinks.map(([label, href]) => (
        <a href={href}>{label}</a>
      ))}
    </p>
    {
      others.length > 0 && (
        <nav class="others" aria-label={`Other ${game?.name ?? "game"} mods`}>
          <h2>Other {game?.name} mods</h2>
          <div class="chips">
            {others.map((entry) => (
              <a class="mod-chip" style={heroVars(entry.slug)} href={`/${entry.game}/${entry.slug}`}>
                <span class="mark">{lookFor(entry.slug).mark}</span>
                <strong>{entry.name}</strong>
              </a>
            ))}
          </div>
        </nav>
      )
    }
    <ReportForm game={mod.game} mod={mod.slug} name={mod.name} gameName={game?.name ?? ""} />
  </article>
    )
  }
</Base>
