---
import Base from "../../layouts/Base.astro";
import ReportForm from "../../components/ReportForm.astro";
import ConfigBuilder from "../../components/ConfigBuilder.astro";
import { games } from "../../data/games";
import { hubInfo } from "../../data/hub-index";
import { fileFacts, gameVersionLabel, isNotReady, mods, modsForGame, previewFor, r2Download, uploadedOn, versionDownload, type ModEntry } from "../../data/mods";
import { renderInline } from "../../../scripts/release-notes.mjs";
import { statRows } from "../../data/stats";
import { statText, statValues } from "../../data/stat-values.mjs";
import { statsSnapshot } from "../../data/stats-snapshot";
import { commandsFor } from "../../data/sevendays-commands";
import { indexInfo, installHints, installLabels } from "../../data/sevendays-index";
import { heroVars, lookFor } from "../../data/themes";

export function getStaticPaths() {
  return mods.map((mod) => ({
    params: { slug: mod.game, mod: mod.slug },
    props: { mod },
  }));
}

interface Props {
  mod: ModEntry;
}

const { mod } = Astro.props;
const game = games.find((entry) => entry.slug === mod.game);
const look = lookFor(mod.slug);
const picture = previewFor(mod);
// A square store icon sits beside the title; a wide poster gets its own row.
const icon = picture?.square ? picture.src : undefined;
const preview = picture && !picture.square ? picture.poster : undefined;
const direct = r2Download(mod);
const updated = uploadedOn(mod);
const notReady = isNotReady(mod);
const feedHref = `/${mod.game}/${mod.slug}/feed.xml`;
const latestKey = notReady ? undefined : `${mod.game}/${mod.slug}`;
const sevendays = mod.game === "7-days-to-die";
const sevenInfo = sevendays ? indexInfo(mod) : undefined;
const info = sevenInfo ?? hubInfo(mod);
const countRows = statRows(mod.game, true);
const countValues = statValues(statsSnapshot, "mod", `${mod.game}/${mod.slug}`);
const commands = sevendays ? commandsFor(mod.slug) : undefined;
const guide = mod.guide;
// The "Works with" list links each mod this game has a page for.
const nameKey = (name: string) => name.toLowerCase().replace(/[^a-z0-9]/g, "");
const sameGame = new Map(modsForGame(mod.game).map((entry) => [nameKey(entry.name), entry]));
const compatEntries = (list: { name: string; note: string }[] | undefined) =>
  (list ?? []).map((entry) => {
    const match = sameGame.get(nameKey(entry.name));
    return { ...entry, href: match ? `/${match.game}/${match.slug}/` : undefined };
  });
const compatGroups = [
  { kind: "good", label: "Works with", entries: compatEntries(guide?.worksWith) },
  { kind: "avoid", label: "Leave these off", entries: compatEntries(guide?.avoid) },
].filter((group) => group.entries.length);
const compatTitle = compatGroups.length === 1 ? compatGroups[0].label : "Alongside other mods";
const overview = guide?.overview?.length ? guide.overview : [mod.description];
const sections = guide?.sections ?? [];
const facts = fileFacts(mod);
const worksOn = gameVersionLabel(mod);
const changelog = mod.changelog ?? [];
// A big release lists its first few changes; the rest fold away.
const NOTES_SHOWN = 6;
const siteUrl = (Astro.site?.origin ?? "https://azraelsmods.com").replace(/\/$/, "");
const pageUrl = `${siteUrl}/${mod.game}/${mod.slug}/`;
const badgeBase = `/badge/${mod.game}/${mod.slug}`;
const badgeMarkdown = `[![Downloads](${siteUrl}${badgeBase}.svg)](${pageUrl}) [![Version](${siteUrl}${badgeBase}/version.svg)](${pageUrl})`;
const changeDate = new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeZone: "UTC" });
const changeLabel = (date?: string) => (date && !Number.isNaN(Date.parse(date)) ? changeDate.format(new Date(date)) : "");
// Search engines read this as the mod's card: what it is, the version, and where it sits on the site.
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: mod.name,
    description: mod.description,
    url: `${siteUrl}/${mod.game}/${mod.slug}`,
    applicationCategory: "GameApplication",
    applicationSubCategory: `${game?.name ?? "Game"} mod`,
    operatingSystem: "Windows",
    softwareVersion: mod.version,
    ...(picture ? { image: `${siteUrl}${picture.src}` } : {}),
    ...(updated ? { dateModified: updated.iso } : {}),
    ...(mod.requires?.length ? { softwareRequirements: mod.requires.join(", ") } : {}),
    author: { "@type": "Person", name: "Azrael", url: siteUrl },
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Azrael's Mods", item: `${siteUrl}/` },
      { "@type": "ListItem", position: 2, name: `${game?.name ?? "Game"} mods`, item: `${siteUrl}/${mod.game}` },
      { "@type": "ListItem", position: 3, name: mod.name, item: `${siteUrl}/${mod.game}/${mod.slug}` },
    ],
  },
];
const storeLinks = [
  ["Steam", mod.links.steam],
  ["Thunderstore", mod.links.thunderstore],
  ["Nexus", mod.links.nexus],
].filter((entry): entry is [string, string] => Boolean(entry[1]));
---

<Base
  title={`${mod.name} · ${game?.name ?? "Mods"}`}
  description={mod.description}
  game={mod.game}
  image={picture ? { src: picture.src, alt: `${mod.name} preview`, square: picture.square } : undefined}
  feed={notReady ? undefined : { title: `${mod.name} updates`, href: feedHref }}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
      <div
        class:list={[
          mod.game === "rimworld" ? "rw-hub rw-mod" : mod.game === "sun-haven" ? "sh-hub sh-mod" : "zd-hub zd-mod",
          "guide-page",
        ]}
        style={heroVars(mod.slug)}
      >
        <header class="rw-hero">
          <div class="rw-wrap rw-hero-layout">
            <div>
              <p class="rw-kicker">
                <a href={`/${mod.game}`}>← All {game?.name} mods</a>
              </p>
              {icon ? (
                <div class="rw-title-icon">
                  <img src={icon} alt="" width="96" height="96" />
                  <h1>{mod.name}</h1>
                </div>
              ) : (
                <h1>{mod.name}</h1>
              )}
              <p class="rw-tagline">{look.mark}</p>
              {
                guide?.badges?.length ? (
                  <p class="rw-pills">
                    {guide.badges.map((badge) => (
                      <span>{badge}</span>
                    ))}
                  </p>
                ) : null
              }
              {overview.map((paragraph) => (
                <p class="rw-intro">{paragraph}</p>
              ))}
              <p class="rw-actions">
                {
                  direct && (
                    <a class="download" href={direct.url}>
                      Download <span data-latest={latestKey} data-latest-field="file">{direct.file}</span>
                    </a>
                  )
                }
                {
                  notReady && (
                    <a class="download" href="/not-ready">
                      Download
                    </a>
                  )
                }
                {storeLinks.map(([label, href]) => (
                  <a href={href}>{label}</a>
                ))}
                <button type="button" class="rw-report" data-open-report aria-haspopup="dialog" aria-controls="report">
                  Report a problem
                </button>
              </p>
            </div>
            <aside class="rw-stats zd-details" aria-labelledby="mod-details" data-stat-scope="mod" data-stat-key={`${mod.game}/${mod.slug}`}>
              <h2 class="rw-stat-label" id="mod-details">Details</h2>
              <dl>
                <div>
                  <dt>Type</dt>
                  <dd>{info.category}</dd>
                </div>
                {sevenInfo && (
                  <div>
                    <dt>Installs on</dt>
                    <dd>
                      <span class:list={["zd-side", `is-${sevenInfo.installs}`]}>{installLabels[sevenInfo.installs]}</span>
                      <small>{installHints[sevenInfo.installs]}</small>
                    </dd>
                  </div>
                )}
                <div>
                  <dt>Version</dt>
                  <dd>
                    v<span data-latest={latestKey} data-latest-field="version">{mod.version}</span>
                    {updated && (
                      <span class="zd-dim">
                        {" "}· <time datetime={updated.iso} data-latest={latestKey} data-latest-field="uploadedAt">{updated.label}</time>
                      </span>
                    )}
                  </dd>
                </div>
                {countRows.map((row) => (
                  <div>
                    <dt>{row.label}</dt>
                    <dd data-field={row.field}>{statText(countValues, row.field)}</dd>
                  </div>
                ))}
                {(worksOn || mod.requires?.length) && (
                  <div>
                    <dt>{worksOn ? "Works on" : "Needs"}</dt>
                    <dd>
                      {worksOn ?? mod.requires?.join(", ")}
                      {worksOn && mod.requires?.length ? <small>Needs {mod.requires.join(", ")}</small> : null}
                    </dd>
                  </div>
                )}
                {direct && (
                  <div>
                    <dt>File</dt>
                    <dd>
                      <span data-latest={latestKey} data-latest-field="file">{direct.file}</span>
                      <span class="zd-file-meta">
                        <span class="zd-dim" hidden={facts.size ? undefined : true} data-fact="size">
                          <span data-latest={latestKey} data-latest-field="size">{facts.size ?? ""}</span>
                        </span>
                        <details class="zd-verify" hidden={facts.sha256 ? undefined : true} data-fact="sha256">
                          <summary>Verify file</summary>
                          <span class="zd-hash">
                            <span class="zd-dim">SHA-256</span>
                            <code data-latest={latestKey} data-latest-field="sha256" data-value={facts.sha256} title={facts.sha256}>
                              {facts.sha256 ? `${facts.sha256.slice(0, 16)}…` : ""}
                            </code>
                            <button type="button" class="zd-copy" data-copy-hash>Copy</button>
                          </span>
                        </details>
                      </span>
                    </dd>
                  </div>
                )}
              </dl>
              <details class="zd-verify zd-badges">
                <summary>README badges</summary>
                <span class="zd-badge-preview">
                  <img src={`${badgeBase}.svg`} alt="Downloads badge" height="20" loading="lazy" />
                  <img src={`${badgeBase}/version.svg`} alt="Version badge" height="20" loading="lazy" />
                </span>
                <span class="zd-hash">
                  <code data-value={badgeMarkdown} title={badgeMarkdown}>Markdown</code>
                  <button type="button" class="zd-copy" data-copy-hash>Copy</button>
                </span>
              </details>
            </aside>
          </div>
        </header>
        <div class="rw-wrap">
          {
            preview && (
              <figure class="rw-poster">
                <img
                  src={preview}
                  srcset={picture?.srcset}
                  fetchpriority="high"
                  sizes={picture?.srcset ? (sevendays ? "(max-width: 936px) calc(100vw - 2.5rem), 896px" : "(max-width: 1180px) calc(100vw - 2.5rem), 1140px") : undefined}
                  alt={`${mod.name} preview`}
                  width={picture?.width ?? 960}
                  height={picture?.height ?? 540}
                  decoding="async"
                />
              </figure>
            )
          }
          {
            sections.length > 0 && (
              <section class="rw-section" data-feature-tabs>
                <h2>What it does</h2>
                {
                  sections.length > 1 && (
                    <div class="rw-tabs" role="tablist" aria-label={`${mod.name} topics`}>
                      {sections.map((section, index) => (
                        <button
                          type="button"
                          role="tab"
                          id={`tab-${section.id}`}
                          aria-controls={`panel-${section.id}`}
                          data-tab={section.id}
                          aria-selected={index === 0 ? "true" : "false"}
                          tabindex={index === 0 ? undefined : "-1"}
                        >
                          {section.label}
                        </button>
                      ))}
                    </div>
                  )
                }
                {sections.map((section, index) => (
                  <div
                    class="rw-features"
                    role={sections.length > 1 ? "tabpanel" : undefined}
                    id={`panel-${section.id}`}
                    aria-labelledby={sections.length > 1 ? `tab-${section.id}` : undefined}
                    data-panel={section.id}
                    hidden={index === 0 ? undefined : true}
                  >
                    {section.features.map((feature) => (
                      <article class="rw-feature">
                        <h3>
                          {feature.title}
                          {feature.tag && <span class="rw-feature-tag">{feature.tag}</span>}
                        </h3>
                        <p>{feature.body}</p>
                      </article>
                    ))}
                  </div>
                ))}
              </section>
            )
          }
          {
            commands && (
              <section class="rw-section zd-commands">
                <h2>Commands</h2>
                {commands.intro && <p class="rw-intro">{commands.intro}</p>}
                {commands.groups.map((group) => (
                  <div class="zd-command-group">
                    <h3>
                      {group.title}
                      {group.aliases && <span class="rw-feature-tag">Also: {group.aliases}</span>}
                    </h3>
                    {group.note && <p class="rw-intro">{group.note}</p>}
                    <dl>
                      {group.rows.map((row) => (
                        <div>
                          <dt>
                            <code>
                              {row.cmd.split("|").map((part, index) => (
                                <>
                                  {index > 0 && <>|<wbr /></>}
                                  {part}
                                </>
                              ))}
                            </code>
                          </dt>
                          <dd>
                            {row.does}
                            {row.admin && <span class="rw-feature-tag">Admin</span>}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                ))}
              </section>
            )
          }
          {sevendays && mod.configs?.map((config) => <ConfigBuilder config={config} name={mod.name} />)}
          {
            changelog.length > 0 && (
              <section class="rw-section zd-changelog" id="changelog" aria-labelledby="changelog-title">
                <div class="zd-changelog-head">
                  <h2 id="changelog-title">What's new</h2>
                  {!notReady && (
                    <a class="zd-follow" href={feedHref} title={`Get new ${mod.name} versions in your RSS reader`}>
                      Follow updates (RSS)
                    </a>
                  )}
                </div>
                {changelog.length > 1 && (
                  <div class="zd-since">
                    <label>
                      <span>Updating? I have</span>
                      <select id="since-version" aria-controls="since-box">
                        <option value="">pick your version</option>
                        {changelog.slice(1).map((entry) => (
                          <option value={entry.version}>v{entry.version}</option>
                        ))}
                      </select>
                    </label>
                    <div class="zd-since-box" id="since-box" aria-live="polite" hidden></div>
                  </div>
                )}
                {changelog.slice(0, 1).map((entry) => (
                  <article class="zd-change" data-version={entry.version}>
                    <h3>
                      <span class="zd-change-version">v{entry.version}</span>
                      {entry.date && <time datetime={entry.date}>{changeLabel(entry.date)}</time>}
                      {entry.version === mod.version && <span class="rw-feature-tag">Current</span>}
                    </h3>
                    <ul class="rw-notes">
                      {entry.notes.slice(0, NOTES_SHOWN).map((note) => (
                        <li set:html={renderInline(note)} />
                      ))}
                    </ul>
                    {entry.notes.length > NOTES_SHOWN && (
                      <details class="zd-older zd-more-notes">
                        <summary>{entry.notes.length - NOTES_SHOWN} more changes in v{entry.version}</summary>
                        <ul class="rw-notes">
                          {entry.notes.slice(NOTES_SHOWN).map((note) => (
                            <li set:html={renderInline(note)} />
                          ))}
                        </ul>
                      </details>
                    )}
                  </article>
                ))}
                {
                  changelog.length > 1 && (
                    <details class="zd-older">
                      <summary>
                        Older versions <span class="zd-dim">({changelog.slice(1).map((entry) => `v${entry.version}`).join(", ")})</span>
                      </summary>
                      {changelog.slice(1).map((entry) => (
                        <article class="zd-change" data-version={entry.version}>
                          <h3>
                            <span class="zd-change-version">v{entry.version}</span>
                            {entry.date && <time datetime={entry.date}>{changeLabel(entry.date)}</time>}
                            {versionDownload(mod, entry.version) && (
                              <a class="zd-old-dl" href={versionDownload(mod, entry.version)} rel="nofollow">
                                Download v{entry.version}
                              </a>
                            )}
                          </h3>
                          <ul class="rw-notes">
                            {entry.notes.map((note) => (
                              <li set:html={renderInline(note)} />
                            ))}
                          </ul>
                        </article>
                      ))}
                    </details>
                  )
                }
              </section>
            )
          }
          {
            !notReady && (
              <section class="rw-section zd-trend" id="trend" data-trend={`${mod.game}/${mod.slug}`} aria-labelledby="trend-title" hidden>
                <div class="zd-changelog-head">
                  <h2 id="trend-title">Downloads, last 30 days</h2>
                  <p class="zd-trend-total" data-trend-total></p>
                </div>
                <div class="zd-trend-plot" data-trend-plot></div>
                <p class="zd-trend-note">Downloads from this site plus the daily gain on Thunderstore and Nexus, in UTC days.</p>
              </section>
            )
          }
          {
            guide?.notes?.length ? (
              <section class="rw-section">
                <h2>Good to know</h2>
                <ul class="rw-notes">
                  {guide.notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>
              </section>
            ) : null
          }
          {
            guide?.faq && (
              <section class="rw-section">
                <h2>{guide.faq.title}</h2>
                {guide.faq.intro && <p class="rw-intro">{guide.faq.intro}</p>}
                <div class="rw-faq">
                  {guide.faq.rows.map((row) => (
                    <article>
                      <h3>{row.pair}</h3>
                      <p>{row.answer}</p>
                    </article>
                  ))}
                </div>
              </section>
            )
          }
          {
            compatGroups.length || guide?.compatNotes?.length ? (
              <section class="rw-section">
                <h2>{compatTitle}</h2>
                {compatGroups.map((group) => (
                  <div class={`rw-compat rw-compat-${group.kind}`}>
                    {compatGroups.length > 1 && <h3 class="rw-compat-label">{group.label}</h3>}
                    <ul>
                      {group.entries.map((entry) => (
                        <li>
                          <span class="rw-compat-name">
                            {entry.href ? <a href={entry.href}>{entry.name}</a> : entry.name}
                          </span>
                          {entry.note && <span class="rw-compat-note">{entry.note}</span>}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
                {guide.compatNotes?.map((note) => (
                  <p class="rw-intro">{note}</p>
                ))}
              </section>
            ) : null
          }
          <ReportForm game={mod.game} mod={mod.slug} name={mod.name} gameName={game?.name ?? ""} />
        </div>
        <script is:inline>
          for (const button of document.querySelectorAll("[data-copy-hash]")) {
            button.addEventListener("click", async () => {
              const hash = button.closest(".zd-hash")?.querySelector("code")?.dataset.value;
              if (!hash) return;
              try {
                await navigator.clipboard.writeText(hash);
                button.textContent = "Copied";
              } catch {
                button.textContent = "Copy failed";
              }
              setTimeout(() => (button.textContent = "Copy"), 2000);
            });
          }
        </script>
        <script is:inline>
          // "I have vX": every change between that version and the newest, in one list.
          (() => {
            const pick = document.querySelector("#since-version");
            const box = document.querySelector("#since-box");
            if (!pick || !box) return;
            const entries = [...document.querySelectorAll("#changelog .zd-change[data-version]")];
            const show = (version) => {
              const at = entries.findIndex((entry) => entry.dataset.version === version);
              box.replaceChildren();
              box.hidden = at < 1;
              if (at < 1) return;
              const newer = entries.slice(0, at);
              const head = document.createElement("p");
              head.className = "zd-since-head";
              const count = newer.reduce((total, entry) => total + entry.querySelectorAll(".rw-notes li").length, 0);
              head.textContent = `Since v${version}: ${newer.length} ${newer.length === 1 ? "version" : "versions"}, ${count} ${count === 1 ? "change" : "changes"}.`;
              box.append(head);
              for (const entry of newer) {
                const label = document.createElement("h4");
                label.textContent = `v${entry.dataset.version}`;
                const list = document.createElement("ul");
                list.className = "rw-notes";
                for (const note of entry.querySelectorAll(".rw-notes li")) list.append(note.cloneNode(true));
                box.append(label, list);
              }
            };
            pick.addEventListener("change", () => show(pick.value));
            // The update checker links here with ?from=<version>.
            const from = new URLSearchParams(location.search).get("from");
            if (from && [...pick.options].some((option) => option.value === from)) {
              pick.value = from;
              show(from);
            }
          })();
          // The 30-day download chart. Left hidden when there is nothing to draw yet.
          (() => {
            const section = document.querySelector("[data-trend]");
            if (!section) return;
            const svgEl = (tag, attrs = {}) => {
              const el = document.createElementNS("http://www.w3.org/2000/svg", tag);
              for (const [name, value] of Object.entries(attrs)) el.setAttribute(name, String(value));
              return el;
            };
            const number = new Intl.NumberFormat("en-US");
            const shortDay = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
            const dayLabel = (day) => shortDay.format(new Date(`${day}T00:00:00Z`));
            fetch(`/api/trends?mod=${encodeURIComponent(section.dataset.trend)}`)
              .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
              .then(({ days = [], total = [] }) => {
                const sum = total.reduce((all, value) => all + value, 0);
                if (days.length === 0 || sum === 0) return;
                const width = 640;
                const height = 180;
                const pad = { top: 10, right: 8, bottom: 24, left: 36 };
                const innerW = width - pad.left - pad.right;
                const innerH = height - pad.top - pad.bottom;
                // Four whole-number gridline steps: 1, 2 or 5 times a power of ten.
                const raw = Math.max(1, Math.max(...total) / 4);
                const mag = 10 ** Math.floor(Math.log10(raw));
                const step = [1, 2, 5, 10].map((mult) => mult * mag).find((candidate) => candidate >= raw);
                const max = Math.max(4, Math.ceil(step) * 4);
                const svg = svgEl("svg", { viewBox: `0 0 ${width} ${height}`, role: "img", "aria-label": `${number.format(sum)} downloads in the last ${days.length} days` });
                for (let tick = 0; tick <= 4; tick += 1) {
                  const value = (max / 4) * tick;
                  const y = pad.top + innerH - (value / max) * innerH;
                  svg.append(svgEl("line", { x1: pad.left, x2: width - pad.right, y1: y, y2: y, class: tick === 0 ? "zd-trend-axis" : "zd-trend-grid" }));
                  const label = svgEl("text", { x: pad.left - 6, y: y + 4, "text-anchor": "end", class: "zd-trend-tick" });
                  label.textContent = number.format(Math.round(value));
                  svg.append(label);
                }
                const slot = innerW / days.length;
                const barW = Math.max(2, Math.min(16, slot - 2));
                const labelEvery = Math.ceil(days.length / 6);
                total.forEach((value, at) => {
                  const x = pad.left + at * slot + (slot - barW) / 2;
                  const group = svgEl("g", { class: "zd-trend-bar" });
                  group.append(svgEl("rect", { x: pad.left + at * slot, y: pad.top, width: slot, height: innerH, class: "zd-trend-hit" }));
                  if (value > 0) {
                    const h = Math.max(1, (value / max) * innerH);
                    const r = Math.min(3, barW / 2, h);
                    const top = pad.top + innerH - h;
                    group.append(
                      svgEl("path", {
                        d: `M${x},${pad.top + innerH}V${top + r}Q${x},${top} ${x + r},${top}H${x + barW - r}Q${x + barW},${top} ${x + barW},${top + r}V${pad.top + innerH}Z`,
                        class: "zd-trend-fill",
                      }),
                    );
                  }
                  const tip = svgEl("title");
                  tip.textContent = `${dayLabel(days[at])}: ${number.format(value)}`;
                  group.append(tip);
                  svg.append(group);
                  if (at % labelEvery === 0 || at === days.length - 1) {
                    const label = svgEl("text", { x: pad.left + at * slot + slot / 2, y: height - 7, "text-anchor": at === days.length - 1 ? "end" : "middle", class: "zd-trend-tick" });
                    if (at === days.length - 1) label.setAttribute("x", String(width - pad.right));
                    label.textContent = dayLabel(days[at]);
                    svg.append(label);
                  }
                });
                section.querySelector("[data-trend-plot]").replaceChildren(svg);
                section.querySelector("[data-trend-total]").textContent = `${number.format(sum)} downloads`;
                section.hidden = false;
              })
              .catch(() => {});
          })();
        </script>
        <script is:inline>
          const root = document.querySelector("[data-feature-tabs]");
          if (root) {
            const tabs = [...root.querySelectorAll("[data-tab]")];
            const panels = [...root.querySelectorAll("[data-panel]")];
            const show = (id) => {
              for (const tab of tabs) {
                const on = tab.dataset.tab === id;
                tab.setAttribute("aria-selected", on ? "true" : "false");
                if (on) tab.removeAttribute("tabindex");
                else tab.setAttribute("tabindex", "-1");
              }
              for (const panel of panels) panel.hidden = panel.dataset.panel !== id;
            };
            for (const tab of tabs) tab.addEventListener("click", () => show(tab.dataset.tab));
            // Arrow keys move between tabs, Home and End jump to the ends.
            root.querySelector('[role="tablist"]')?.addEventListener("keydown", (event) => {
              const at = tabs.indexOf(document.activeElement);
              if (at < 0) return;
              const next = { ArrowRight: at + 1, ArrowLeft: at - 1, Home: 0, End: tabs.length - 1 }[event.key];
              if (next === undefined) return;
              event.preventDefault();
              const tab = tabs[(next + tabs.length) % tabs.length];
              show(tab.dataset.tab);
              tab.focus();
            });
          }
        </script>
      </div>
</Base>
