{
  "name": "azraels-mods-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/collect-mods.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/collect-mods.mjs",
    "build": "astro build",
    "catalog": "node scripts/collect-mods.mjs",
    "preview": "astro preview",
    "test": "node --test test/report.test.mjs test/kats-catalog.test.mjs test/stats.test.mjs",
    "build:kats": "node kats/scripts/build-assets.mjs",
    "dev:kats": "npm run build:kats && wrangler dev --config kats/wrangler.jsonc",
    "deploy:kats": "npm run build:kats && wrangler deploy --config kats/wrangler.jsonc",
    "dev:worker": "npm run build && wrangler dev",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "node-unrar-js": "^2.0.2",
    "wrangler": "^4.147.0"
  }
}
